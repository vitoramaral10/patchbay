package main

import (
	"strconv"

	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

// dadosPainel é o retrato que a tela inicial mostra.
type dadosPainel struct {
	Upstreams        int
	UpstreamsProntos int
	UpstreamsRuins   int
	Endpoints        int
	Ferramentas      int
	// Lapides é quantas ferramentas removidas ainda respondem explicando que
	// saíram, somando todos os endpoints. Elas custam o mesmo orçamento de
	// contexto que uma ferramenta viva, e por isso aparecem ao lado da
	// contagem (seção 08.3).
	Lapides          int
	Chaves           int
	ChavesAtivas     int
	URLPublica       string
	URLLocal         bool
	ClientesOAuth    int
	PrimeiroEndpoint string
}

// passoInicio é um item do "comece aqui".
type passoInicio struct {
	Titulo, Texto, Rota, Botao string
	Feito                      bool
}

func passosDoInicio(d dadosPainel) []passoInicio {
	return []passoInicio{
		{
			Titulo: "Adicione um MCP",
			Texto:  "Cole a URL, o comando ou o JSON que a documentação do servidor mostra.",
			Rota:   webui.RotaUpstreams + "/adicionar", Botao: "Adicionar MCP",
			Feito: d.Upstreams > 0,
		},
		{
			Titulo: "Diga onde o patchbay está",
			Texto:  "Para o claude.ai chegar aqui, informe o domínio público. Uso só nesta máquina dispensa.",
			Rota:   webui.RotaConfiguracao, Botao: "Abrir Ajustes",
			Feito: !d.URLLocal,
		},
		{
			Titulo: "Conecte o seu cliente de IA",
			Texto:  "A tela do endpoint mostra o que copiar para o claude.ai, o Claude Code ou o Cursor.",
			Rota:   d.PrimeiroEndpoint, Botao: "Ver como conectar",
			Feito: d.ClientesOAuth > 0 || d.ChavesAtivas > 0,
		},
	}
}

func faltaAlgum(ps []passoInicio) bool {
	for _, p := range ps {
		if !p.Feito {
			return true
		}
	}
	return false
}

// telaPainel é a primeira tela depois do login: o que está no ar, e o próximo
// passo quando não há nada.
templ telaPainel(d dadosPainel, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Início",
		Subtitulo: "Tudo o que você muda aqui vale na hora.",
		Secao:     webui.SecaoPainel,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Alerta:    alerta,
	}) {
		<div class="flex flex-col gap-6">
			if ps := passosDoInicio(d); faltaAlgum(ps) {
				@webui.Cartao("Comece aqui") {
					<ol class="divide-y divide-borda">
						for i, p := range ps {
							<li class="flex flex-wrap items-center gap-4 px-5 py-4">
								if p.Feito {
									<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-sucesso-fraco text-sucesso">
										@webui.Icone("ok")
										<span class="sr-only">Feito:</span>
									</span>
								} else {
									<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-acento-fraco font-semibold text-acento">{ strconv.Itoa(i + 1) }</span>
								}
								<div class="min-w-0 flex-1">
									<p class={ "font-semibold", templ.KV("text-conteudo-tenue line-through", p.Feito), templ.KV("text-conteudo", !p.Feito) }>{ p.Titulo }</p>
									if !p.Feito {
										<p class="text-sm text-conteudo-suave">{ p.Texto }</p>
									}
								</div>
								if !p.Feito && p.Rota != "" {
									<a href={ templ.SafeURL(p.Rota) } class="pb-botao pb-botao-primario">{ p.Botao }</a>
								}
							</li>
						}
					</ol>
				}
			}
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				@indicador("MCPs", strconv.Itoa(d.Upstreams), rodapeUpstreams(d), webui.RotaUpstreams)
				@indicador("Endpoints", strconv.Itoa(d.Endpoints), "no ar", webui.RotaEndpoints)
				@indicador("Ferramentas", valorFerramentas(d), "somando todos os endpoints", webui.RotaEndpoints)
				@indicador("Apps conectados", strconv.Itoa(d.ClientesOAuth + d.ChavesAtivas), "por login ou chave", webui.RotaClientesOAuth)
			</div>
		</div>
	}
}

// valorFerramentas é o número que o indicador mostra: a contagem de
// ferramentas vivas, e as lápides ao lado quando houver, porque as duas
// custam o mesmo orçamento de contexto do cliente (seção 08.3).
func valorFerramentas(d dadosPainel) string {
	if d.Lapides == 0 {
		return strconv.Itoa(d.Ferramentas)
	}
	return strconv.Itoa(d.Ferramentas) + " + " + strconv.Itoa(d.Lapides) + " saindo"
}

func rodapeUpstreams(d dadosPainel) string {
	if d.UpstreamsRuins > 0 {
		return strconv.Itoa(d.UpstreamsProntos) + " prontos, " + strconv.Itoa(d.UpstreamsRuins) + " com problema"
	}
	return strconv.Itoa(d.UpstreamsProntos) + " prontos"
}

func rodapeChaves(d dadosPainel) string {
	revogadas := d.Chaves - d.ChavesAtivas
	if revogadas > 0 {
		return strconv.Itoa(revogadas) + " revogadas"
	}
	return "nenhuma revogada"
}

templ indicador(rotulo, valor, rodape, rota string) {
	<a href={ templ.SafeURL(rota) } class="pb-cartao flex flex-col gap-1 px-4 py-4 transition-colors duration-150 ease-out hover:bg-superficie-alta">
		<span class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">{ rotulo }</span>
		<span class="text-2xl font-semibold tracking-tight text-conteudo tabular-nums">{ valor }</span>
		<span class="text-sm text-conteudo-tenue">{ rodape }</span>
	</a>
}
