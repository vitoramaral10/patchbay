# Copie para google.env (git-ignorado) antes de `docker compose --profile google up`.
# Cliente OAuth do tipo Web num projeto do Google Cloud com as APIs dos serviços
# habilitados em --tools ativadas (Drive, Gmail, Calendar, Docs, Sheets, Slides,
# Forms, Tasks e People). Com o app em "Teste" o Google invalida o refresh token
# em 7 dias; publique o app ("Em produção") para o token não expirar sozinho.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
