# Binários de ferramenta baixados por `task ui:ferramentas` (Tailwind CLI
# standalone). Os artefatos que eles geram — *_templ.go e o CSS compilado —
# ficam versionados, para que `go build ./...` não precise de toolchain de
# front-end.
/ferramentas/

# Segredo local do docker-compose.yml de exemplo — nunca o versionado
# secrets.env.exemplo, que fica sem valor.
/secrets.env

# worktrees de agentes
.claude/worktrees/

# Cache de páginas do `task biblioteca`. É só o HTML bruto da origem, para a
# atualização do catálogo poder continuar de onde parou; o artefato versionado
# é o internal/biblioteca/catalogo.json.
/.cache-biblioteca/
