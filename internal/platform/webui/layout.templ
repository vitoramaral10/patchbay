package webui

// DadosPagina é o que o shell precisa saber para desenhar uma tela.
type DadosPagina struct {
	// Titulo vira o <title> e o <h1>. Único por tela.
	Titulo string
	// Subtitulo é a linha de contexto abaixo do título.
	Subtitulo string
	// Secao marca o item ativo da navegação. Vazio esconde a navegação, que é
	// o caso das telas de setup e de login.
	Secao string
	// Usuario aparece no canto quando há sessão.
	Usuario string
	// Acao é a única ação primária da tela, no cabeçalho.
	Acao templ.Component
	// Alerta é a mensagem de resultado da ação anterior.
	Alerta *Alerta
}

// Tom classifica um alerta ou um selo. Cor nunca é o único portador da
// informação: o rótulo de texto vai junto, sempre.
type Tom string

// Tons possíveis.
const (
	TomNeutro  Tom = "neutro"
	TomInfo    Tom = "info"
	TomSucesso Tom = "sucesso"
	TomAlerta  Tom = "alerta"
	TomPerigo  Tom = "perigo"
)

// Alerta é a mensagem de resultado de uma ação.
type Alerta struct {
	Tom   Tom
	Titulo string
	Texto  string
}

func classesAlerta(t Tom) string {
	switch t {
	case TomSucesso:
		return "border-sucesso/40 bg-sucesso-fraco text-conteudo"
	case TomAlerta:
		return "border-alerta/40 bg-alerta-fraco text-conteudo"
	case TomPerigo:
		return "border-perigo/40 bg-perigo-fraco text-conteudo"
	case TomInfo:
		return "border-info/40 bg-info-fraco text-conteudo"
	default:
		return "border-borda bg-superficie-alta text-conteudo"
	}
}

func classesSelo(t Tom) string {
	switch t {
	case TomSucesso:
		return "bg-sucesso-fraco text-sucesso"
	case TomAlerta:
		return "bg-alerta-fraco text-alerta"
	case TomPerigo:
		return "bg-perigo-fraco text-perigo"
	case TomInfo:
		return "bg-info-fraco text-info"
	default:
		return "bg-superficie-alta text-conteudo-suave"
	}
}

func classesNav(ativo bool) string {
	if ativo {
		return "bg-acento-fraco text-acento font-semibold"
	}
	return "text-conteudo-suave hover:bg-superficie-alta hover:text-conteudo"
}

func classesAba(ativo bool) string {
	if ativo {
		return "bg-acento text-acento-fg shadow-sm"
	}
	return "text-conteudo-suave hover:bg-superficie hover:text-acento"
}

// Pagina é o shell de toda tela: menu lateral fixo no desktop, gaveta no
// celular (checkbox + label, sem JS), barra superior em cartão e as abas do
// item ativo do menu.
templ Pagina(p DadosPagina) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ p.Titulo } · patchbay</title>
			<link rel="stylesheet" href={ URLCSS() }/>
			<script src={ URLHTMX() } defer></script>
			<script src={ URLHTMXSSE() } defer></script>
		</head>
		<body class="min-h-screen">
			<a
				href="#conteudo"
				class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-superficie focus:px-3 focus:py-2 focus:text-conteudo"
			>
				Pular para o conteúdo
			</a>
			if p.Secao != "" {
				<input type="checkbox" id="pb-menu-aberto" class="peer sr-only" aria-hidden="true" tabindex="-1"/>
				@menuLateral(p)
				<label
					for="pb-menu-aberto"
					aria-hidden="true"
					class="fixed inset-0 z-30 hidden bg-black/40 peer-checked:block lg:peer-checked:hidden"
				></label>
				<div class="lg:pl-64">
					<div class="mx-auto w-full max-w-6xl px-4 pt-4 sm:px-6">
						@barraSuperior(p)
					</div>
					@conteudo(p) {
						{ children... }
					}
				</div>
			} else {
				@conteudo(p) {
					{ children... }
				}
			}
		</body>
	</html>
}

templ conteudo(p DadosPagina) {
	<main id="conteudo" class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
		<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold tracking-tight text-conteudo">{ p.Titulo }</h1>
				if p.Subtitulo != "" {
					<p class="mt-1 max-w-[65ch] text-conteudo-suave">{ p.Subtitulo }</p>
				}
			</div>
			if p.Acao != nil {
				<div class="shrink-0">
					@p.Acao
				</div>
			}
		</header>
		if item, ok := itemAtivo(p.Secao); ok && len(item.Abas) > 1 {
			<nav aria-label="Telas de { item.Rotulo }" class="mb-6 flex flex-wrap gap-2">
				for _, aba := range item.Abas {
					<a
						href={ templ.SafeURL(aba.Rota) }
						class={ "rounded-md px-4 py-2 text-sm font-medium transition-colors duration-150 ease-out", classesAba(aba.Secao == p.Secao) }
						if aba.Secao == p.Secao {
							aria-current="page"
						}
					>{ aba.Rotulo }</a>
				}
			</nav>
		}
		if p.Alerta != nil {
			@AlertaCaixa(*p.Alerta)
		}
		{ children... }
	</main>
}

templ menuLateral(p DadosPagina) {
	<aside
		class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-superficie transition-transform duration-200 ease-out peer-checked:translate-x-0 lg:translate-x-0"
		style="box-shadow: var(--pb-sombra-menu)"
	>
		<a href={ templ.SafeURL(RotaPainel) } class="flex h-16 items-center gap-2.5 px-6 text-xl font-bold tracking-tight text-conteudo">
			<span aria-hidden="true" class="grid h-8 w-8 place-items-center rounded-md bg-acento text-acento-fg">
				@Icone("logo")
			</span>
			patchbay
		</a>
		<nav aria-label="Seções" class="flex-1 overflow-y-auto px-3 py-2">
			<ul class="flex flex-col gap-1">
				for _, item := range navegacao {
					<li>
						<a
							href={ templ.SafeURL(item.Rota) }
							class={ "flex items-center gap-3 rounded-md px-3 py-2.5 text-[0.9375rem] transition-colors duration-150 ease-out", classesNav(item.ativo(p.Secao)) }
							if item.ativo(p.Secao) {
								aria-current="page"
							}
						>
							@Icone(item.Icone)
							{ item.Rotulo }
						</a>
					</li>
				}
			</ul>
		</nav>
	</aside>
}

templ barraSuperior(p DadosPagina) {
	<div class="pb-cartao flex h-14 items-center gap-3 px-4">
		<label for="pb-menu-aberto" class="pb-botao cursor-pointer px-2 text-conteudo-suave hover:text-conteudo lg:hidden">
			@Icone("menu")
			<span class="sr-only">Abrir o menu</span>
		</label>
		<span class="truncate text-sm text-conteudo-tenue">{ p.Titulo }</span>
		if p.Usuario != "" {
			<form method="post" action={ templ.SafeURL(RotaSair) } class="ml-auto flex items-center gap-3">
				<span class="hidden text-sm text-conteudo-suave sm:inline">{ p.Usuario }</span>
				<span aria-hidden="true" class="grid h-9 w-9 place-items-center rounded-full bg-acento-fraco text-sm font-semibold uppercase text-acento">
					{ inicial(p.Usuario) }
				</span>
				<button type="submit" class="pb-botao pb-botao-secundario px-2.5 py-1.5 text-xs">
					@Icone("sair")
					Sair
				</button>
			</form>
		}
	</div>
}

func inicial(nome string) string {
	for _, r := range nome {
		return string(r)
	}
	return "?"
}

// Icone desenha um ícone de traço (estilo Lucide, ISC) em 20px, sempre
// decorativo: o texto ao lado é quem informa.
templ Icone(nome string) {
	<svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
		switch nome {
			case "logo":
				<path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path>
			case "inicio":
				<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path d="M9 22V12h6v10"></path>
			case "endpoint":
				<path d="M12 2v6"></path><path d="M6 8h12v4a6 6 0 0 1-12 0z"></path><path d="M12 18v4"></path>
			case "mcp":
				<rect x="2" y="3" width="20" height="7" rx="2"></rect><rect x="2" y="14" width="20" height="7" rx="2"></rect><path d="M6 6.5h.01"></path><path d="M6 17.5h.01"></path>
			case "atividade":
				<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
			case "ajustes":
				<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle>
			case "menu":
				<path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>
			case "sair":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path>
			case "mais":
				<path d="M12 5v14"></path><path d="M5 12h14"></path>
			case "copiar":
				<rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			case "ok":
				<path d="M20 6 9 17l-5-5"></path>
		}
	</svg>
}

// AlertaCaixa mostra o resultado da ação anterior. Erro diz o que houve e o que
// fazer; nunca imprime detalhe interno.
templ AlertaCaixa(a Alerta) {
	<div
		class={ "mb-6 rounded-md border px-4 py-3", classesAlerta(a.Tom) }
		if a.Tom == TomPerigo {
			role="alert"
		} else {
			role="status"
		}
	>
		if a.Titulo != "" {
			<p class="font-medium">{ a.Titulo }</p>
		}
		if a.Texto != "" {
			<p class="mt-0.5 text-conteudo-suave">{ a.Texto }</p>
		}
	</div>
}

// Selo é o rótulo de estado. Sempre com texto: cor sozinha não informa.
templ Selo(t Tom, texto string) {
	<span class={ "pb-selo", classesSelo(t) }>
		<span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>
		{ texto }
	</span>
}

// DadosCampo descreve um campo de formulário.
type DadosCampo struct {
	Nome      string
	Rotulo    string
	Valor     string
	Tipo      string // text, password, url, number; vazio = text
	Ajuda     string
	Erro      string
	Obrigatorio bool
	SoLeitura bool
	Placeholder string
	AutoComplete string
	Monoespacado bool
}

func (c DadosCampo) tipo() string {
	if c.Tipo == "" {
		return "text"
	}
	return c.Tipo
}

func (c DadosCampo) descritoPor() string {
	switch {
	case c.Erro != "":
		return c.Nome + "-erro"
	case c.Ajuda != "":
		return c.Nome + "-ajuda"
	default:
		return ""
	}
}

// Campo é o par rótulo + entrada. Label sempre existe: placeholder não é label,
// porque some ao digitar e some para o leitor de tela.
templ Campo(c DadosCampo) {
	<div class="flex flex-col gap-1.5">
		<label for={ c.Nome } class="text-sm font-medium text-conteudo">
			{ c.Rotulo }
			if c.Obrigatorio {
				<span class="text-perigo" aria-hidden="true">*</span>
				<span class="sr-only">(obrigatório)</span>
			}
		</label>
		<input
			class={ "pb-campo", templ.KV("font-mono", c.Monoespacado) }
			id={ c.Nome }
			name={ c.Nome }
			type={ c.tipo() }
			value={ c.Valor }
			if c.Placeholder != "" {
				placeholder={ c.Placeholder }
			}
			if c.AutoComplete != "" {
				autocomplete={ c.AutoComplete }
			}
			if c.Obrigatorio {
				required
			}
			if c.SoLeitura {
				readonly
			}
			if c.Erro != "" {
				aria-invalid="true"
			}
			if c.descritoPor() != "" {
				aria-describedby={ c.descritoPor() }
			}
		/>
		if c.Erro != "" {
			<p id={ c.Nome + "-erro" } class="text-sm text-perigo">{ c.Erro }</p>
		} else if c.Ajuda != "" {
			<p id={ c.Nome + "-ajuda" } class="text-sm text-conteudo-tenue">{ c.Ajuda }</p>
		}
	</div>
}

// CampoTexto é o Campo de várias linhas.
templ CampoTexto(c DadosCampo) {
	<div class="flex flex-col gap-1.5">
		<label for={ c.Nome } class="text-sm font-medium text-conteudo">{ c.Rotulo }</label>
		<textarea
			class="pb-campo min-h-24 resize-y"
			id={ c.Nome }
			name={ c.Nome }
			rows="4"
			if c.Placeholder != "" {
				placeholder={ c.Placeholder }
			}
			if c.descritoPor() != "" {
				aria-describedby={ c.descritoPor() }
			}
		>{ c.Valor }</textarea>
		if c.Erro != "" {
			<p id={ c.Nome + "-erro" } class="text-sm text-perigo">{ c.Erro }</p>
		} else if c.Ajuda != "" {
			<p id={ c.Nome + "-ajuda" } class="text-sm text-conteudo-tenue">{ c.Ajuda }</p>
		}
	</div>
}

// Vazio é o estado de lista sem nenhum item: uma frase do que aparece ali e a
// ação que cria o primeiro. Diferente de busca sem resultado, que não existe
// nesta UI.
templ Vazio(titulo, texto string) {
	<div class="pb-cartao flex flex-col items-center gap-3 px-6 py-14 text-center">
		<p class="text-base font-medium text-conteudo">{ titulo }</p>
		<p class="max-w-[55ch] text-conteudo-suave">{ texto }</p>
		{ children... }
	</div>
}

// Tabela é a tabela de listagem: o embrulho que rola na horizontal, a <table> e
// a legenda. Os filhos são o <thead> e o <tbody>.
//
// Existe por causa da legenda. O par embrulho + tabela estava copiado igual em
// nove lugares, e só um deles tinha <caption> — as outras oito não diziam a um
// leitor de tela o que estavam listando. Sendo componente, a legenda deixa de
// ser algo de que alguém precisa lembrar e passa a ser o argumento que não dá
// para omitir.
//
// A legenda é sr-only: a tela já tem o título do cartão acima, e repetir a
// frase seria ruído para quem enxerga.
templ Tabela(legenda string) {
	<div class="overflow-x-auto">
		<table class="w-full text-left">
			<caption class="sr-only">{ legenda }</caption>
			{ children... }
		</table>
	</div>
}

// BotaoAcao é o botão de uma ação htmx. Enquanto a requisição está no ar o
// rótulo troca para Pendente e o htmx desliga o botão, para que o clique não
// suma no vazio numa chamada que sai para um MCP remoto.
//
// Classes é o que vem depois de pb-botao — a variante e, quando for o caso, o
// tamanho: "pb-botao-perigo px-2.5 py-1.5 text-xs".
//
// Pendente é o mesmo verbo no gerúndio, e diz o que está acontecendo: "Sondar
// agora" vira "Sondando…", "Remover" vira "Removendo…". Rótulo em texto, e não
// spinner: a razão está no .pb-pendente do entrada.css.
templ BotaoAcao(classes, rotulo, pendente string) {
	<button type="submit" class={ "pb-botao", classes }>
		<span class="pb-ocioso">{ rotulo }</span>
		<span class="pb-pendente">{ pendente }</span>
	</button>
}

// Cartao agrupa conteúdo com um título de seção.
templ Cartao(titulo string) {
	<section class="pb-cartao overflow-hidden">
		if titulo != "" {
			<h2 class="border-b border-borda px-4 py-3 text-base font-semibold text-conteudo">{ titulo }</h2>
		}
		{ children... }
	</section>
}
