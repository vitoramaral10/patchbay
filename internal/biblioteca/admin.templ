package biblioteca

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

// rotaDeAdicionar é o link do botão: o patchbay lê o servidor no catálogo local
// e redireciona para o formulário preenchido.
//
// O nome vai cru no caminho porque ele já foi validado contra a forma que a
// origem publica — letras, dígitos, ponto, hífen, sublinhado e uma barra. A
// barra é justamente o que precisa sobreviver: ela separa o namespace do nome.
func rotaDeAdicionar(nome string) string {
	return webui.RotaBiblioteca + "/adicionar/" + nome
}

// resumoDaPagina descreve em uma linha o que está sendo mostrado.
func resumoDaPagina(p Pagina) string {
	total := strconv.Itoa(p.Total)
	if p.Filtro.Termo != "" {
		return total + " servidores no catálogo para " + strconv.Quote(p.Filtro.Termo)
	}
	return total + " servidores no catálogo"
}

// idadeDoCatalogo diz de quando é o que está na tela.
//
// Em palavra e não em carimbo de data porque a pergunta do admin não é "que
// horas eram", é "isto está velho?". A resposta em horas responde essa.
func idadeDoCatalogo(e Sincronizacao) string {
	if e.Nunca() {
		return "ainda não foi baixado"
	}
	d := e.Idade()
	switch {
	case d < time.Minute:
		return "atualizado agora"
	case d < time.Hour:
		return fmt.Sprintf("atualizado há %d min", int(d.Minutes()))
	case d < 48*time.Hour:
		return fmt.Sprintf("atualizado há %d h", int(d.Hours()))
	default:
		return fmt.Sprintf("atualizado há %d dias", int(d.Hours()/24))
	}
}

// horaDaTentativa é quando a última varredura foi tentada, em hora de parede.
//
// Hora de parede e não "há X" porque ao lado vem o motivo do erro: o admin
// cruza isso com log ou com quando ele mesmo pediu para tentar de novo, e para
// isso precisa do instante exato, não de quanto tempo faz.
func horaDaTentativa(e Sincronizacao) string {
	return e.TentadaEm.Local().Format("02/01/2006 15:04:05")
}

// linhaDaConexao é o que o cartão mostra sobre como o servidor é alcançado.
func linhaDaConexao(i Item) string {
	if i.Remoto() {
		return i.URL
	}
	return strings.TrimSpace(i.Comando + " " + strings.Join(i.Args, " "))
}

// rotaDeAdicionarComEndpoint é o link "Adicionar" de um endpoint específico,
// entre os vários que a página do servidor publicou (D-07). O índice é o da
// posição em Endpoints, base 0 — a rota lê de volta em adicionar().
func rotaDeAdicionarComEndpoint(nome string, indice int) string {
	return rotaDeAdicionar(nome) + "?endpoint=" + strconv.Itoa(indice)
}

// slugDoServidor é o trecho do Nome que identifica a página do servidor em
// mcpservers.org/pt-BR/servers/. Vazio quando o Nome não segue o padrão
// "mcpservers.org/<slug>" — aí não há link a mostrar.
func slugDoServidor(i Item) string {
	const prefixo = "mcpservers.org/"
	if !strings.HasPrefix(i.Nome, prefixo) {
		return ""
	}
	return strings.TrimPrefix(i.Nome, prefixo)
}

// rotuloDoTransporte é o transporte em palavra de gente.
func rotuloDoTransporte(i Item) string {
	switch i.Transporte {
	case TransporteSSE:
		return "SSE"
	case TransporteSTDIO:
		return "Processo local"
	default:
		return "HTTP"
	}
}

// TelaBiblioteca é o catálogo de servidores MCP, lido da cópia local.
templ TelaBiblioteca(p Pagina) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Biblioteca",
		Subtitulo: "Servidores MCP da lista oficial do mcpservers.org. Adicionar abre o formulário de MCP preenchido com o que a página do servidor publica — você confere e salva.",
		Secao:     webui.SecaoBiblioteca,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Alerta:    p.Alerta,
	}) {
		<div class="flex flex-col gap-6">
			@webui.Cartao("") {
				<form
					method="get"
					action={ templ.SafeURL(webui.RotaBiblioteca) }
					class="flex flex-col gap-2 px-4 py-4"
					hx-get={ webui.RotaBiblioteca }
					hx-target="#resultados-biblioteca"
					hx-swap="outerHTML"
					hx-trigger="input changed delay:200ms from:find input[type=search], change from:find input[type=checkbox], submit"
					hx-push-url="true"
				>
					<label for="q" class="text-sm font-medium text-conteudo">Buscar no catálogo</label>
					<div class="flex items-center gap-2">
						<input
							class="pb-campo"
							id="q"
							name="q"
							type="search"
							value={ p.Filtro.Termo }
							placeholder="notion, jira, kubernetes, payments..."
							autocomplete="off"
							aria-describedby="q-ajuda"
						/>
						<button type="submit" class="pb-botao pb-botao-secundario">Buscar</button>
					</div>
					<p id="q-ajuda" class="text-sm text-conteudo-tenue">
						A busca procura no nome e na descrição da cópia local — por isso é instantânea. O catálogo é publicado em inglês; termo em português costuma não achar nada.
					</p>
				</form>
			}
			@estadoDoCatalogo(p)
			@Resultados(p)
			@rodapeDaOrigem()
		</div>
	}
}

// estadoDoCatalogo diz de quando é a lista e oferece refazê-la.
//
// Fica acima da lista, e não escondido no rodapé, porque catálogo guardado tem
// idade e ela muda a leitura do que está na tela: não achar um servidor pode
// ser ele não existir ou a cópia ser de ontem, e o admin só sabe qual dos dois
// se a idade estiver à vista.
templ estadoDoCatalogo(p Pagina) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<p class="text-sm text-conteudo-suave">
			Catálogo local: { idadeDoCatalogo(p.Estado) }
			if p.Estado.Servidores > 0 {
				<span class="text-conteudo-tenue">— { strconv.Itoa(p.Estado.Servidores) } servidores na última varredura</span>
			}
			if p.Estado.Erro != "" {
				<span class="text-conteudo-tenue">— a última tentativa, em { horaDaTentativa(p.Estado) }, não terminou: { p.Estado.Erro }</span>
			}
		</p>
		<form method="post" action={ templ.SafeURL(webui.RotaBiblioteca + "/atualizar") }>
			<button type="submit" class="pb-botao pb-botao-secundario" disabled?={ p.EmCurso }>
				if p.EmCurso {
					Atualizando...
				} else {
					Atualizar agora
				}
			</button>
		</form>
	</div>
}

// Resultados é a lista. É o alvo do htmx, e por isso é um componente separado:
// a busca troca só este pedaço.
templ Resultados(p Pagina) {
	<div id="resultados-biblioteca" class="flex flex-col gap-4">
		if len(p.Itens) == 0 {
			if p.CatalogoVazio() {
				@aviso("O catálogo ainda está sendo baixado.",
					"Esta é a primeira varredura da lista oficial do mcpservers.org: são 22 páginas de índice e cerca de 650 páginas de detalhe, com pausa entre elas, e leva de 20 a 35 minutos. Recarregue daqui a pouco — ou cadastre o MCP à mão, que funciona desde já.")
			} else {
				@aviso("Nenhum servidor com esse termo.",
					"A busca é sobre o nome e a descrição, e o catálogo é escrito em inglês. Se o que você quer não está aqui, cadastre o MCP à mão.")
			}
		} else {
			<p class="text-sm text-conteudo-suave">{ resumoDaPagina(p) }</p>
			<ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
				for _, i := range p.Itens {
					@cartaoDoServidor(i)
				}
			</ul>
			@navegacao(p)
		}
	</div>
}

// cartaoDoServidor é uma entrada da lista.
templ cartaoDoServidor(i Item) {
	<li class="pb-cartao flex flex-col gap-3 px-4 py-4">
		<div class="flex flex-col gap-1">
			<div class="flex flex-wrap items-baseline gap-2">
				<h3 class="text-base font-semibold text-conteudo">{ i.Titulo }</h3>
				<span class="text-xs text-conteudo-tenue">{ rotuloDoTransporte(i) }</span>
			</div>
			<p class="text-xs text-conteudo-tenue">{ i.Nome }</p>
			if i.Descricao != "" {
				<p class="text-sm text-conteudo-suave">{ i.Descricao }</p>
			}
			if i.Remoto() || linhaDaConexao(i) != "" {
				<p class="break-all text-xs text-conteudo-tenue">{ linhaDaConexao(i) }</p>
			} else {
				<p class="text-xs text-conteudo-tenue">
					a página deste servidor não publica comando nem endpoint reconhecível — abra a página e cadastre à mão
				</p>
				if slug := slugDoServidor(i); slug != "" {
					<a
						href={ templ.SafeURL("https://mcpservers.org/pt-BR/servers/" + slug) }
						target="_blank"
						rel="noreferrer noopener"
						class="pb-link text-xs"
					>Abrir a página do servidor</a>
				}
			}
			if len(i.Endpoints) > 1 {
				<ul class="flex flex-col gap-1">
					for idx, ep := range i.Endpoints {
						<li class="flex flex-wrap items-center gap-2 text-xs text-conteudo-tenue">
							<span class="break-all">{ ep }</span>
							<a href={ templ.SafeURL(rotaDeAdicionarComEndpoint(i.Nome, idx)) } class="pb-link">Adicionar</a>
						</li>
					}
				</ul>
			}
			if i.PedeCredencial {
				<p class="text-xs text-conteudo-suave">A origem declara que este servidor exige credencial.</p>
			}
		</div>
		<div class="mt-auto flex flex-wrap items-center gap-3 pt-1">
			<a href={ templ.SafeURL(rotaDeAdicionar(i.Nome)) } class="pb-botao pb-botao-primario">
				Adicionar
				<span class="sr-only">{ i.Titulo }</span>
			</a>
			if i.Site != "" {
				<a
					href={ templ.SafeURL(i.Site) }
					target="_blank"
					rel="noreferrer noopener"
					class="pb-link text-sm"
				>
					Ver a origem
					<span class="sr-only">a página de { i.Titulo } (abre em nova aba)</span>
				</a>
			}
		</div>
	</li>
}

// navegacao anda pelas páginas do catálogo local.
//
// Aqui há ida e volta, diferente do que a leitura ao vivo permitia: o catálogo
// é nosso, então dá para contar quantos são e pular para trás.
templ navegacao(p Pagina) {
	if p.Paginas() > 1 {
		<div class="flex flex-wrap items-center gap-3">
			if p.TemAnterior() {
				<a
					href={ templ.SafeURL(p.Anterior()) }
					class="pb-botao pb-botao-secundario"
					hx-get={ p.Anterior() }
					hx-target="#resultados-biblioteca"
					hx-swap="outerHTML"
					hx-push-url="true"
				>Anterior</a>
			}
			<span class="text-sm text-conteudo-tenue">
				Página { strconv.Itoa(p.Numero) } de { strconv.Itoa(p.Paginas()) }
			</span>
			if p.TemProxima() {
				<a
					href={ templ.SafeURL(p.Proxima()) }
					class="pb-botao pb-botao-secundario"
					hx-get={ p.Proxima() }
					hx-target="#resultados-biblioteca"
					hx-swap="outerHTML"
					hx-push-url="true"
				>Próxima</a>
			}
		</div>
	}
}

// aviso é o cartão de estado vazio da tela, com a saída sempre à mão.
//
// Toda situação sem lista termina no mesmo lugar — cadastrar à mão —, porque é
// o que o admin pode fazer agora, e uma tela que só explica o problema deixa
// ele sem próximo passo.
templ aviso(titulo, texto string) {
	<div class="pb-cartao flex flex-col items-center gap-3 px-6 py-14 text-center">
		<p class="text-base font-medium text-conteudo">{ titulo }</p>
		<p class="max-w-[55ch] text-conteudo-suave">{ texto }</p>
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo") } class="pb-botao pb-botao-secundario">Cadastrar à mão</a>
	</div>
}

// rodapeDaOrigem diz de onde veio o que está na tela, e o que ele não é.
//
// Fica na tela, e não só no comentário do pacote, porque o admin precisa saber
// que está lendo um catálogo de terceiro: nem a URL nem o comando foram
// verificados pelo patchbay.
templ rodapeDaOrigem() {
	<p class="text-sm text-conteudo-tenue">
		Cópia local da lista oficial em
		<a href="https://mcpservers.org/pt-BR/official" target="_blank" rel="noreferrer noopener" class="pb-link">mcpservers.org/pt-BR/official</a>,
		refeita a cada 12 horas.
		As URLs e os comandos são de terceiros e não foram verificados pelo patchbay — confira antes de salvar.
	</p>
}
