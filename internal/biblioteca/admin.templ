package biblioteca

import (
	"strconv"

	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

// rotaDeAdicionar é o link do botão: o patchbay busca a página do servidor na
// origem e redireciona para o formulário preenchido.
func rotaDeAdicionar(slug string) string {
	return webui.RotaBiblioteca + "/" + slug + "/adicionar"
}

// resumoDoRecorte descreve em uma linha o que está sendo mostrado.
//
// Vive dentro do fragmento trocado pela busca, e não no cabeçalho da página:
// contagem que não acompanha o filtro é contagem errada na tela.
func resumoDoRecorte(mostrados, total int, termo string) string {
	if termo == "" {
		return strconv.Itoa(total) + " servidores publicados agora pela origem"
	}
	return strconv.Itoa(mostrados) + " de " + strconv.Itoa(total) + " servidores"
}

// TelaBiblioteca é o catálogo de servidores MCP, lido da origem a cada abertura.
templ TelaBiblioteca(p Pagina) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Biblioteca",
		Subtitulo: "Servidores MCP remotos publicados pelo mcpservers.org, lidos na hora. Adicionar busca o endpoint e a forma de autenticação e abre o formulário de upstream preenchido — você confere e salva.",
		Secao:     webui.SecaoBiblioteca,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Alerta:    p.Alerta,
	}) {
		<div class="flex flex-col gap-6">
			@webui.Cartao("") {
				<form
					method="get"
					action={ templ.SafeURL(webui.RotaBiblioteca) }
					class="flex flex-col gap-2 px-4 py-4"
					hx-get={ webui.RotaBiblioteca }
					hx-target="#resultados-biblioteca"
					hx-swap="outerHTML"
					hx-trigger="input changed delay:250ms from:find input, submit"
					hx-push-url="true"
				>
					<label for="q" class="text-sm font-medium text-conteudo">Buscar no catálogo</label>
					<div class="flex items-center gap-2">
						<input
							class="pb-campo"
							id="q"
							name="q"
							type="search"
							value={ p.Termo }
							placeholder="notion, jira, banco de dados, pagamentos..."
							autocomplete="off"
							aria-describedby="q-ajuda"
						/>
						<button type="submit" class="pb-botao pb-botao-secundario">Buscar</button>
					</div>
					<p id="q-ajuda" class="text-sm text-conteudo-tenue">
						Procura no nome e no resumo do que a origem publica. Vários termos exigem todos, em qualquer ordem.
					</p>
				</form>
			}
			@Resultados(p.Itens, p.Termo, p.Total, p.Falha)
			@rodapeDaOrigem()
		</div>
	}
}

// Resultados é a lista. É o alvo do htmx, e por isso é um componente separado:
// a busca troca só este pedaço.
templ Resultados(itens []Item, termo string, total int, falha Falha) {
	<div id="resultados-biblioteca" class="flex flex-col gap-4">
		switch falha {
			case FalhaIndisponivel:
				@aviso("Não foi possível falar com o mcpservers.org.",
					"A biblioteca não guarda cópia do catálogo: ela lê a origem a cada uso, então precisa de saída para a internet. Nada mais do patchbay depende disto — o gateway continua servindo e roteando normalmente.")
			case FalhaFormato:
				@aviso("A origem respondeu num formato que o patchbay não sabe ler.",
					"A página chegou, mas a marcação mudou de lugar — tentar de novo não resolve. O log do processo tem o detalhe.")
			default:
				if len(itens) == 0 {
					@aviso("Nenhum servidor com esse termo.",
						"A origem publica só servidores MCP remotos. Se o que você quer não está aqui — ou é um processo local —, cadastre o upstream à mão.")
				} else {
					<p class="text-sm text-conteudo-suave">{ resumoDoRecorte(len(itens), total, termo) }</p>
					<ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
						for _, i := range itens {
							<li class="pb-cartao flex flex-col gap-3 px-4 py-4">
								<div class="flex flex-col gap-1">
									<h3 class="text-base font-semibold text-conteudo">{ i.Nome }</h3>
									if i.Resumo != "" {
										<p class="text-sm text-conteudo-suave">{ i.Resumo }</p>
									}
								</div>
								<div class="mt-auto flex flex-wrap items-center gap-3 pt-1">
									<a href={ templ.SafeURL(rotaDeAdicionar(i.Slug)) } class="pb-botao pb-botao-primario">
										Adicionar
										<span class="sr-only">{ i.Nome }</span>
									</a>
									<a
										href={ templ.SafeURL(BaseMCPServers + "/remote-mcp-servers/" + i.Slug) }
										target="_blank"
										rel="noreferrer noopener"
										class="pb-link text-sm"
									>
										Ver na origem
										<span class="sr-only">a página de { i.Nome } no mcpservers.org (abre em nova aba)</span>
									</a>
								</div>
							</li>
						}
					</ul>
				}
		}
	</div>
}

// aviso é o cartão de estado vazio da tela, com a saída sempre à mão.
//
// Toda situação sem lista termina no mesmo lugar — cadastrar à mão —, porque é
// o que o admin pode fazer agora, e uma tela que só explica o problema deixa
// ele sem próximo passo.
templ aviso(titulo, texto string) {
	<div class="pb-cartao flex flex-col items-center gap-3 px-6 py-14 text-center">
		<p class="text-base font-medium text-conteudo">{ titulo }</p>
		<p class="max-w-[55ch] text-conteudo-suave">{ texto }</p>
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo") } class="pb-botao pb-botao-secundario">Cadastrar à mão</a>
	</div>
}

// rodapeDaOrigem diz de onde veio o que está na tela, e o que ele não é.
//
// Fica na tela, e não só no comentário do pacote, porque o admin precisa saber
// que está lendo um site de terceiro: a URL não foi verificada pelo patchbay.
templ rodapeDaOrigem() {
	<p class="text-sm text-conteudo-tenue">
		Lido agora de
		<a href={ templ.SafeURL(BaseMCPServers + "/remote-mcp-servers") } target="_blank" rel="noreferrer noopener" class="pb-link">mcpservers.org</a>.
		Nada é guardado aqui: a lista some quando você sai da tela e é buscada de novo na próxima.
		As URLs são de terceiros e não foram verificadas pelo patchbay — confira antes de salvar.
	</p>
}
