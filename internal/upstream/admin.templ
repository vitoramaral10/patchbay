package upstream

import (
	"strconv"
	"strings"
	"time"

	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

func rotaDo(id int64) string { return webui.RotaUpstreams + "/" + strconv.FormatInt(id, 10) }

// tomDoEstado mapeia a máquina de estados nos tons do layout.
//
// Desabilitado tem tom próprio e nunca é verde: um verde que significa "não sei"
// é exatamente a mentira que a seção 11 proíbe.
func tomDoEstado(e Estado, habilitado, supervisionado bool) webui.Tom {
	if !habilitado || !supervisionado {
		return webui.TomNeutro
	}
	switch e {
	case EstadoPronto:
		return webui.TomSucesso
	case EstadoDegradado, EstadoSondaFalhou, EstadoDesabilitado:
		return webui.TomPerigo
	case EstadoConectando, EstadoNovo, EstadoSemConsentimento:
		return webui.TomAlerta
	default:
		return webui.TomNeutro
	}
}

func rotuloDoEstado(e Estado, habilitado, supervisionado bool) string {
	if !habilitado {
		return "desabilitado"
	}
	if !supervisionado {
		return "fora da supervisão"
	}
	switch e {
	case EstadoPronto:
		return "pronto"
	case EstadoDegradado:
		return "degradado"
	case EstadoConectando:
		return "conectando"
	case EstadoNovo:
		return "iniciando"
	case EstadoDesabilitado:
		return "desabilitado por autoproteção"
	case EstadoSondaFalhou:
		return "sonda falhou"
	case EstadoSemConsentimento:
		return "sem consentimento"
	default:
		return string(e)
	}
}

func instante(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return t.Local().Format("02/01/2006 15:04:05")
}

// proximaTentativa descreve o agendamento do backoff em texto curto.
//
// Prazo relativo e não só o horário: "em 8s" responde a pergunta que o admin
// tem na frente da tela sem ele precisar calcular a diferença.
func proximaTentativa(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	falta := time.Until(t).Round(time.Second)
	if falta <= 0 {
		return "agora"
	}
	return "em " + falta.String() + " (" + instante(t) + ")"
}

// TelaLista é a lista de upstreams.
templ TelaLista(linhas []Linha, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Upstreams",
		Subtitulo: "Cada upstream é um servidor MCP externo. O patchbay mantém uma sessão por upstream, aberta fora do caminho da requisição do cliente.",
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      botaoNovo(),
		Alerta:    alerta,
	}) {
		if len(linhas) == 0 {
			@webui.Vazio("Nenhum upstream ainda.",
				"Cadastre o primeiro servidor MCP que o patchbay vai agregar: um servidor Streamable HTTP, ou um processo local que fala MCP pelo stdin e stdout.") {
				@botaoNovo()
			}
		} else {
			@webui.Cartao("") {
				<div class="overflow-x-auto">
					<table class="w-full text-left">
						<thead class="border-b border-borda bg-superficie-alta text-xs uppercase tracking-wide text-conteudo-suave">
							<tr>
								<th scope="col" class="px-4 py-2.5 font-semibold">Upstream</th>
								<th scope="col" class="px-4 py-2.5 font-semibold">Estado</th>
								<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Ferramentas</th>
								<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Endpoints</th>
								<th scope="col" class="px-4 py-2.5 font-semibold">Próxima tentativa</th>
								<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Timeout</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-borda">
							for _, l := range linhas {
								<tr class="transition-colors duration-150 ease-out hover:bg-superficie-alta">
									<td class="px-4 py-3">
										<a href={ templ.SafeURL(rotaDo(l.ID)) } class="pb-link font-medium">{ l.Nome }</a>
										<p class="mt-0.5 flex items-center gap-2">
											@webui.Selo(webui.TomNeutro, rotuloDoTipo(l.Tipo))
										</p>
										<p class="max-w-[48ch] truncate font-mono text-xs text-conteudo-tenue" title={ l.Descricao() }>{ l.Descricao() }</p>
									</td>
									<td class="px-4 py-3">
										@webui.Selo(tomDoEstado(l.Estado, l.Habilitado, l.Supervisionado),
											rotuloDoEstado(l.Estado, l.Habilitado, l.Supervisionado))
										if l.UltimoErro != "" {
											<p class="mt-1 max-w-[40ch] truncate text-xs text-perigo" title={ l.UltimoErro }>{ l.UltimoErro }</p>
										}
									</td>
									<td class="px-4 py-3" data-numero>{ strconv.Itoa(l.Ferramentas) }</td>
									<td class="px-4 py-3" data-numero>{ strconv.Itoa(l.Endpoints) }</td>
									<td class="px-4 py-3 text-sm text-conteudo-suave">
										{ proximaTentativa(l.ProximaEm) }
										if l.Abandonos > 0 {
											<p class="mt-1 text-xs text-conteudo-tenue">{ strconv.Itoa(l.Abandonos) } connect(s) abandonado(s)</p>
										}
										if l.AbandonosTotais > l.Abandonos {
											<p class="text-xs text-conteudo-tenue">{ strconv.Itoa(l.AbandonosTotais) } no total</p>
										}
									</td>
									<td class="px-4 py-3" data-numero>{ strconv.FormatInt(l.TimeoutMS, 10) } ms</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

// botaoNovo oferece os dois tipos como ações separadas.
//
// O tipo é escolhido aqui e não dentro do formulário porque ele não muda depois:
// HTTP e STDIO pedem campos diferentes, e um formulário com os dois conjuntos ao
// mesmo tempo obrigaria o admin a adivinhar quais valem.
templ botaoNovo() {
	<div class="flex items-center gap-2">
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoSTDIO) } class="pb-botao pb-botao-secundario">Novo processo STDIO</a>
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoHTTP) } class="pb-botao pb-botao-primario">Novo upstream HTTP</a>
	</div>
}

// rotuloDoTipo nomeia o transporte na tela.
func rotuloDoTipo(tipo string) string {
	switch tipo {
	case TipoSTDIO:
		return "processo stdio"
	case TipoSSE:
		return "sse"
	default:
		return "streamable http"
	}
}

// TelaDetalhe mostra o estado atual e as ferramentas descobertas.
templ TelaDetalhe(d Detalhe, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    d.Nome,
		Subtitulo: rotuloDoTipo(d.Tipo) + " · " + d.Descricao(),
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      acoesDoDetalhe(d),
		Alerta:    alerta,
	}) {
		<div class="flex flex-col gap-6">
			@webui.Cartao("Estado") {
				<dl class="grid gap-x-6 gap-y-4 px-4 py-4 sm:grid-cols-2 lg:grid-cols-4">
					@dado("Situação") {
						@webui.Selo(tomDoEstado(d.Estado, d.Habilitado, d.Supervisionado),
							rotuloDoEstado(d.Estado, d.Habilitado, d.Supervisionado))
					}
					@dado("Ferramentas descobertas") {
						<span data-numero>{ strconv.Itoa(len(d.Ferramentas)) }</span>
					}
					@dado("Timeout de toda operação") {
						<span data-numero>{ strconv.FormatInt(d.TimeoutMS, 10) } ms</span>
					}
					@dado("Última tentativa") {
						{ instante(d.TentativaEm) }
					}
					@dado("Próxima tentativa") {
						{ proximaTentativa(d.ProximaEm) }
					}
					@dado("Falhas consecutivas") {
						<span data-numero>{ strconv.Itoa(d.Falhas) }</span>
					}
					@dado("Connects abandonados") {
						<span data-numero>{ strconv.Itoa(d.Abandonos) }</span>
						if d.TetoAbandonos > 0 {
							<span class="text-conteudo-tenue">de { strconv.Itoa(d.TetoAbandonos) }</span>
						}
						if d.AbandonosTotais > d.Abandonos {
							<span class="ml-2 text-xs text-conteudo-tenue">({ strconv.Itoa(d.AbandonosTotais) } no total acumulado)</span>
						}
					}
				</dl>
				if d.Motivo != "" {
					<div class="border-t border-borda px-4 py-4">
						<p class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">Por que a supervisão parou</p>
						<p class="mt-1 max-w-[80ch] text-sm text-perigo">{ d.Motivo }</p>
						<p class="mt-2 max-w-[65ch] text-sm text-conteudo-suave">
							Nada disso foi gravado no banco: o único estado persistido é o de
							<em>habilitado</em>. Reiniciar o patchbay, ou clicar em Reconectar, recomeça a
							máquina em <em>novo</em>.
						</p>
					</div>
				}
				if d.UltimoErro != "" {
					<div class="border-t border-borda px-4 py-4">
						<p class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">Último erro</p>
						<p class="mt-1 max-w-[80ch] break-words font-mono text-sm text-perigo">{ d.UltimoErro }</p>
						<p class="mt-2 max-w-[65ch] text-sm text-conteudo-suave">
							O upstream continua na lista com o motivo à vista, e a supervisão tenta de novo
							quando o backoff vencer — exponencial com jitter e teto, para que a frequência de
							tentativa caia enquanto o servidor não volta. O erro vive em memória: o banco
							guarda só a intenção de habilitar.
						</p>
					</div>
				}
			}
			if d.STDIO() {
				@webui.Cartao("Processo") {
					<div class="flex flex-col gap-4 px-4 py-4">
						<p class="max-w-[65ch] text-sm text-conteudo-suave">
							Um processo por upstream, compartilhado por todas as sessões de cliente. Ele nasce
							numa árvore própria do sistema operacional — <em>process group</em> no Linux e no
							macOS, <em>Job Object</em> no Windows —, e ao encerrar morre a árvore inteira,
							inclusive o neto que o programa tenha lançado. Matar só o filho direto é o que
							vaza processo até esgotar os PIDs da máquina.
						</p>
						<dl class="grid gap-x-6 gap-y-4">
							@dado("Linha de comando") {
								<code class="block max-w-[80ch] break-all font-mono text-sm">{ LinhaDeComando(d.Comando, d.Args) }</code>
							}
							@dado("Argumentos") {
								if len(d.Args) == 0 {
									<span class="text-conteudo-tenue">nenhum</span>
								} else {
									<ol class="flex flex-col gap-1">
										for _, a := range d.Args {
											<li><code class="font-mono text-xs">{ a }</code></li>
										}
									</ol>
								}
							}
							@dado("Variáveis de ambiente") {
								if len(d.VariaveisEmClaro()) == 0 {
									<span class="text-conteudo-tenue">nenhuma além do ambiente do patchbay</span>
								} else {
									<ul class="flex flex-col gap-1">
										for _, p := range d.VariaveisEmClaro() {
											<li><code class="font-mono text-xs">{ p.Nome }={ p.Valor }</code></li>
										}
									</ul>
								}
							}
						</dl>
						<p class="max-w-[65ch] text-sm text-conteudo-tenue">
							O processo herda o ambiente do patchbay e recebe estas variáveis por cima, mais as
							cifradas listadas abaixo. Sem a herança, um servidor lançado por
							<code class="font-mono">npx</code> ou <code class="font-mono">uvx</code> não acharia
							nem o próprio interpretador.
						</p>
					</div>
				}
			}
			@webui.Cartao("Ferramentas descobertas") {
				if len(d.Ferramentas) == 0 {
					<p class="px-4 py-6 max-w-[65ch] text-conteudo-suave">
						Nenhuma ferramenta no último <code class="font-mono">tools/list</code> bem-sucedido.
						if !d.Habilitado {
							O upstream está desabilitado, então não há sessão aberta.
						} else if d.Estado == EstadoDegradado {
							O upstream está degradado: as ferramentas saem do catálogo enquanto ele não responde,
							porque ferramenta que não funciona custa contexto no cliente sem entregar nada.
							Os endpoints continuam servindo o que os outros upstreams trazem, e as ferramentas
							que saíram ainda respondem por uma janela de graça explicando que saíram.
						} else if d.Estado == EstadoDesabilitado {
							A supervisão se desligou sozinha ao passar do teto de connects abandonados.
							Use Reconectar quando o servidor voltar a responder.
						} else {
							A supervisão ainda está conectando.
						}
					</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-left">
							<thead class="border-b border-borda bg-superficie-alta text-xs uppercase tracking-wide text-conteudo-suave">
								<tr>
									<th scope="col" class="px-4 py-2.5 font-semibold">Nome exposto</th>
									<th scope="col" class="px-4 py-2.5 font-semibold">Nome no upstream</th>
									<th scope="col" class="px-4 py-2.5 font-semibold">Descrição</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-borda">
								for _, f := range d.Ferramentas {
									<tr>
										<td class="px-4 py-3 align-top">
											<code class="font-mono text-sm">{ f.NomeExposto }</code>
											if len(f.Avisos) > 0 {
												<p class="mt-1 flex flex-wrap gap-1">
													for _, aviso := range f.Avisos {
														@webui.Selo(webui.TomAlerta, strings.ReplaceAll(aviso, "_", " "))
													}
												</p>
											}
										</td>
										<td class="px-4 py-3 align-top">
											<code class="font-mono text-sm text-conteudo-suave">{ f.NomeOriginal }</code>
										</td>
										<td class="max-w-[60ch] px-4 py-3 align-top text-conteudo-suave">
											if f.Descricao == "" {
												<span class="text-conteudo-tenue">sem descrição</span>
											} else {
												{ f.Descricao }
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
			@webui.Cartao("Credenciais apresentadas ao upstream") {
				<div class="flex flex-col gap-4 px-4 py-4">
					<p class="max-w-[65ch] text-sm text-conteudo-suave">
						O que o patchbay apresenta ao upstream fica cifrado em repouso (AES-256-GCM, chave
						derivada da chave mestra). O valor não volta para esta tela nem para o log — o que
						aparece aqui é só se ele está definido. Para trocar, edite o upstream.
					</p>
					<dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
						if d.STDIO() {
							@dado("Variáveis de ambiente cifradas") {
								if len(d.VariaveisSecretas()) == 0 {
									<span class="text-conteudo-tenue">nenhuma</span>
								} else {
									<ul class="flex flex-wrap gap-2">
										for _, v := range d.VariaveisSecretas() {
											<li class="flex items-center gap-2 rounded-md bg-superficie-alta px-2 py-1">
												<code class="font-mono text-xs">{ v.Nome }</code>
												@webui.Selo(webui.TomSucesso, "definida")
											</li>
										}
									</ul>
								}
							}
						} else {
							@dado("Bearer") {
								if d.TemBearer() {
									@webui.Selo(webui.TomSucesso, "definido")
								} else {
									@webui.Selo(webui.TomNeutro, "não definido")
								}
							}
							@dado("Headers estáticos") {
								if len(d.HeadersEstaticos()) == 0 {
									<span class="text-conteudo-tenue">nenhum</span>
								} else {
									<ul class="flex flex-wrap gap-2">
										for _, h := range d.HeadersEstaticos() {
											<li class="flex items-center gap-2 rounded-md bg-superficie-alta px-2 py-1">
												<code class="font-mono text-xs">{ h.Nome }</code>
												@webui.Selo(webui.TomSucesso, "definido")
											</li>
										}
									</ul>
								}
							}
						}
					</dl>
				</div>
			}
			@webui.Cartao("Endpoints que incluem este upstream") {
				if len(d.Endpoints) == 0 {
					<p class="px-4 py-6 max-w-[65ch] text-conteudo-suave">
						Nenhum endpoint inclui este upstream, então as ferramentas dele não chegam a cliente nenhum.
						Edite um endpoint para compô-lo.
					</p>
				} else {
					<ul class="flex flex-wrap gap-2 px-4 py-4">
						for _, slug := range d.Endpoints {
							<li class="rounded-md bg-superficie-alta px-2 py-1 font-mono text-xs text-conteudo-suave">{ slug }</li>
						}
					</ul>
				}
			}
		</div>
	}
}

templ acoesDoDetalhe(d Detalhe) {
	<div class="flex items-center gap-2">
		if d.Habilitado {
			<form
				method="post"
				action={ templ.SafeURL(rotaDo(d.ID) + "/reconectar") }
				hx-post={ rotaDo(d.ID) + "/reconectar" }
				hx-disabled-elt="find button"
			>
				<button type="submit" class="pb-botao pb-botao-secundario">Reconectar</button>
			</form>
		}
		<form
			method="post"
			action={ templ.SafeURL(rotaDo(d.ID) + "/remover") }
			hx-post={ rotaDo(d.ID) + "/remover" }
			hx-confirm={ avisoDeRemocao(d) }
			hx-disabled-elt="find button"
		>
			<button type="submit" class="pb-botao pb-botao-perigo">Remover</button>
		</form>
		<a href={ templ.SafeURL(rotaDo(d.ID) + "/editar") } class="pb-botao pb-botao-primario">Editar</a>
	</div>
}

func avisoDeRemocao(d Detalhe) string {
	base := "Remover o upstream " + d.Nome + "? A sessão é fechada na hora."
	if len(d.Endpoints) == 0 {
		return base
	}
	return base + " As ferramentas dele saem de " + strconv.Itoa(len(d.Endpoints)) +
		" endpoint(s): " + strings.Join(d.Endpoints, ", ") + "."
}

templ dado(rotulo string) {
	<div>
		<dt class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">{ rotulo }</dt>
		<dd class="mt-1 text-conteudo">
			{ children... }
		</dd>
	</div>
}

// TelaForm serve a criação e a edição de upstream, HTTP ou STDIO.
//
// O tipo viaja em campo escondido e não em seletor: ele é escolhido na criação e
// não muda depois. Trocar o transporte de um upstream vivo não é editá-lo, é
// substituí-lo — outras ferramentas, outras credenciais, outro modo de falha.
templ TelaForm(f Form) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    tituloDoForm(f),
		Subtitulo: subtituloDoForm(f),
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
	}) {
		<form method="post" action={ templ.SafeURL(acaoDoForm(f)) } class="flex max-w-2xl flex-col gap-8">
			<input type="hidden" name="tipo" value={ f.TipoEfetivo() }/>
			@webui.Cartao(tituloDaConexao(f)) {
				<div class="flex flex-col gap-6 px-4 py-5">
					@webui.Campo(webui.DadosCampo{
						Nome:        "nome",
						Rotulo:      "Nome",
						Valor:       f.Nome,
						Ajuda:       "Como o upstream aparece nesta administração e no log.",
						Erro:        f.Erros["nome"],
						Obrigatorio: true,
					})
					if f.STDIO() {
						@webui.Campo(webui.DadosCampo{
							Nome:         "comando",
							Rotulo:       "Comando",
							Valor:        f.Comando,
							Ajuda:        "O programa a executar, resolvido pelo PATH do processo patchbay. Por exemplo npx, uvx, node ou um caminho completo.",
							Erro:         f.Erros["comando"],
							Obrigatorio:  true,
							Monoespacado: true,
							Placeholder:  "npx",
						})
						@webui.CampoTexto(webui.DadosCampo{
							Nome:        "args",
							Rotulo:      "Argumentos",
							Valor:       f.ArgsTexto,
							Ajuda:       "Um argumento por linha. Nada de linha de comando partida por espaço: argumento com espaço dentro é normal, e um separador escolhido aqui viraria uma regra de escape para você descobrir errando.",
							Erro:        f.Erros["args"],
							Placeholder: "-y\n@modelcontextprotocol/server-filesystem\nC:\\dados",
						})
						@webui.CampoTexto(webui.DadosCampo{
							Nome:        "env",
							Rotulo:      "Variáveis de ambiente (não sensíveis)",
							Valor:       f.EnvTexto,
							Ajuda:       "NOME=valor, uma por linha. Vão em claro no banco e aparecem na tela — é o lugar de PATH extra e nível de log, nunca de token. Segredo vai no bloco cifrado abaixo.",
							Erro:        f.Erros["env"],
							Placeholder: "NODE_ENV=production",
						})
					} else {
						@webui.Campo(webui.DadosCampo{
							Nome:         "url",
							Rotulo:       "URL do endpoint MCP",
							Tipo:         "url",
							Valor:        f.URL,
							Ajuda:        "O endereço Streamable HTTP do servidor, normalmente terminando em /mcp.",
							Erro:         f.Erros["url"],
							Obrigatorio:  true,
							Monoespacado: true,
							Placeholder:  "https://exemplo.com/mcp",
						})
					}
					@webui.Campo(webui.DadosCampo{
						Nome:         "timeout_ms",
						Rotulo:       "Timeout (ms)",
						Tipo:         "number",
						Valor:        strconv.FormatInt(f.TimeoutMS, 10),
						Ajuda:        "Vale para conectar, listar e chamar ferramenta neste upstream. Entre 250 e 120000.",
						Erro:         f.Erros["timeout_ms"],
						Obrigatorio:  true,
						Monoespacado: true,
					})
					<label class="flex items-start gap-3">
						<input
							type="checkbox"
							name="habilitado"
							value="1"
							class="mt-0.5 h-4 w-4 accent-[var(--pb-acento)]"
							checked?={ f.Habilitado }
						/>
						<span>
							<span class="text-sm font-medium text-conteudo">Habilitado</span>
							<span class="block text-sm text-conteudo-tenue">
								Desmarcar fecha a sessão na hora e tira as ferramentas dos endpoints, sem apagar o cadastro.
							</span>
						</span>
					</label>
				</div>
			}
			@webui.Cartao("Credenciais") {
				<div class="flex flex-col gap-6 px-4 py-5">
					<p class="max-w-[65ch] text-sm text-conteudo-suave">
						O que o patchbay <strong>apresenta</strong> ao upstream é cifrado em repouso com
						AES-256-GCM e nunca é reexibido aqui. Campo em branco mantém o valor gravado;
						para tirar a credencial, marque <em>limpar</em>.
					</p>
					if f.STDIO() {
						<fieldset class="flex flex-col gap-3">
							<legend class="text-sm font-medium text-conteudo">Variáveis de ambiente sensíveis</legend>
							if f.Erros["env_secreto"] != "" {
								<p class="text-sm text-perigo">{ f.Erros["env_secreto"] }</p>
							}
							for i, e := range f.EnvSecretos {
								@linhaEnv(i, e)
							}
							<p class="text-sm text-conteudo-tenue">
								O token de um servidor lançado por linha de comando é a mesma classe de segredo
								que o bearer de um servidor HTTP: vai cifrado, e entra no bloco de ambiente do
								processo na hora de iniciá-lo.
							</p>
						</fieldset>
					} else {
						@credenciaisHTTP(f)
					}
				</div>
			}
			<div class="flex items-center gap-3">
				<button type="submit" class="pb-botao pb-botao-primario">
					if f.ID == 0 {
						Criar upstream
					} else {
						Salvar
					}
				</button>
				<a href={ templ.SafeURL(webui.RotaUpstreams) } class="pb-botao pb-botao-secundario">Cancelar</a>
			</div>
		</form>
	}
}

// credenciaisHTTP é o bloco de bearer e headers estáticos.
templ credenciaisHTTP(f Form) {
	<div class="flex flex-col gap-6">
		<div class="flex flex-col gap-1.5">
			<div class="flex items-center gap-2">
				<label for="bearer" class="text-sm font-medium text-conteudo">Bearer token</label>
				if f.BearerDefinido {
					@webui.Selo(webui.TomSucesso, "definido")
				} else {
					@webui.Selo(webui.TomNeutro, "não definido")
				}
			</div>
			<input
				class="pb-campo font-mono"
				id="bearer"
				name="bearer"
				type="password"
				autocomplete="new-password"
				placeholder={ marcadorDeSegredo(f.BearerDefinido) }
				if f.Erros["bearer"] != "" {
					aria-invalid="true"
				}
				aria-describedby="bearer-ajuda"
			/>
			if f.Erros["bearer"] != "" {
				<p id="bearer-ajuda" class="text-sm text-perigo">{ f.Erros["bearer"] }</p>
			} else {
				<p id="bearer-ajuda" class="text-sm text-conteudo-tenue">
					Vai como <code class="font-mono">Authorization: Bearer …</code> em toda requisição
					para este upstream.
				</p>
			}
			if f.BearerDefinido {
				<label class="mt-1 flex items-center gap-2">
					<input type="checkbox" name="bearer_limpar" value="1" class="h-4 w-4 accent-[var(--pb-acento)]"/>
					<span class="text-sm text-conteudo-suave">Limpar o bearer gravado</span>
				</label>
			}
		</div>
		<fieldset class="flex flex-col gap-3">
			<legend class="text-sm font-medium text-conteudo">Headers estáticos</legend>
			if f.Erros["headers"] != "" {
				<p class="text-sm text-perigo">{ f.Erros["headers"] }</p>
			}
			for i, h := range f.Headers {
				@linhaHeader(i, h)
			}
			<p class="text-sm text-conteudo-tenue">
				Um par nome/valor por linha, enviado em toda requisição.
				<code class="font-mono">Authorization</code> não entra aqui: use o campo de bearer acima.
			</p>
		</fieldset>
	</div>
}

// linhaEnv é uma linha da tabela de variáveis de ambiente cifradas.
//
// Mesma regra do linhaHeader: o nome de uma variável já gravada vai em campo
// escondido e aparece como texto, porque ele é a chave da linha no banco e do
// AAD da cifra — editá-lo criaria outra variável em vez de renomear esta.
templ linhaEnv(indice int, e CampoEnv) {
	<div class="flex flex-col gap-1.5 rounded-md border border-borda px-3 py-3">
		<div class="flex flex-wrap items-center gap-2">
			if e.Definido {
				<input type="hidden" name="env_nome" value={ e.Nome }/>
				<code class="font-mono text-sm text-conteudo">{ e.Nome }</code>
				@webui.Selo(webui.TomSucesso, "definida")
			} else {
				<input
					class="pb-campo font-mono sm:max-w-64"
					name="env_nome"
					type="text"
					value={ e.Nome }
					placeholder="GITHUB_TOKEN"
					aria-label={ "Nome da variável " + strconv.Itoa(indice+1) }
				/>
			}
		</div>
		<input
			class="pb-campo font-mono"
			name="env_valor"
			type="password"
			autocomplete="new-password"
			placeholder={ marcadorDeSegredo(e.Definido) }
			aria-label={ "Valor da variável " + strconv.Itoa(indice+1) }
			if e.Erro != "" {
				aria-invalid="true"
			}
		/>
		if e.Erro != "" {
			<p class="text-sm text-perigo">{ e.Erro }</p>
		}
		if e.Definido {
			<label class="flex items-center gap-2">
				<input type="checkbox" name="env_limpar" value={ e.Nome } class="h-4 w-4 accent-[var(--pb-acento)]"/>
				<span class="text-sm text-conteudo-suave">Limpar esta variável</span>
			</label>
		}
	</div>
}

// marcadorDeSegredo é o placeholder de um campo de segredo. Nunca o valor: o
// placeholder é o único texto de um campo de senha que a tela mostra.
func marcadorDeSegredo(definido bool) string {
	if definido {
		return "deixe em branco para manter o valor gravado"
	}
	return "cole o valor aqui"
}

// linhaHeader é uma linha da tabela de headers estáticos.
//
// O nome de um header já gravado vai em campo escondido e aparece como texto: é
// a chave da linha no banco e do AAD da cifra, e deixá-lo editável faria "trocar
// o nome" parecer renomear quando na verdade cria outro header.
templ linhaHeader(indice int, h CampoHeader) {
	<div class="flex flex-col gap-1.5 rounded-md border border-borda px-3 py-3">
		<div class="flex flex-wrap items-center gap-2">
			if h.Definido {
				<input type="hidden" name="header_nome" value={ h.Nome }/>
				<code class="font-mono text-sm text-conteudo">{ h.Nome }</code>
				@webui.Selo(webui.TomSucesso, "definido")
			} else {
				<input
					class="pb-campo font-mono sm:max-w-64"
					name="header_nome"
					type="text"
					value={ h.Nome }
					placeholder="X-Api-Key"
					aria-label={ "Nome do header " + strconv.Itoa(indice+1) }
				/>
			}
		</div>
		<input
			class="pb-campo font-mono"
			name="header_valor"
			type="password"
			autocomplete="new-password"
			placeholder={ marcadorDeSegredo(h.Definido) }
			aria-label={ "Valor do header " + strconv.Itoa(indice+1) }
			if h.Erro != "" {
				aria-invalid="true"
			}
		/>
		if h.Erro != "" {
			<p class="text-sm text-perigo">{ h.Erro }</p>
		}
		if h.Definido {
			<label class="flex items-center gap-2">
				<input type="checkbox" name="header_limpar" value={ h.Nome } class="h-4 w-4 accent-[var(--pb-acento)]"/>
				<span class="text-sm text-conteudo-suave">Limpar este header</span>
			</label>
		}
	</div>
}

func tituloDoForm(f Form) string {
	acao := "Editar"
	if f.ID == 0 {
		acao = "Novo"
	}
	if f.STDIO() {
		return acao + " upstream STDIO"
	}
	return acao + " upstream HTTP"
}

func subtituloDoForm(f Form) string {
	if f.STDIO() {
		return "Um processo local que fala MCP pelo stdin e stdout. O patchbay mantém um processo por upstream, " +
			"compartilhado por todas as sessões, e mata a árvore inteira ao encerrar. " +
			"Variáveis sensíveis são cifradas em repouso e nunca voltam para esta tela."
	}
	return "Upstream MCP Streamable HTTP. Bearer e headers estáticos são cifrados em repouso e nunca voltam para esta tela."
}

func tituloDaConexao(f Form) string {
	if f.STDIO() {
		return "Processo"
	}
	return "Conexão"
}

func acaoDoForm(f Form) string {
	if f.ID == 0 {
		return webui.RotaUpstreams
	}
	return rotaDo(f.ID)
}
