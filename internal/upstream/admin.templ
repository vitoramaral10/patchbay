package upstream

import (
	"strconv"
	"strings"
	"time"

	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

func rotaDo(id int64) string { return webui.RotaUpstreams + "/" + strconv.FormatInt(id, 10) }

// tomDoEstado mapeia a máquina de estados nos tons do layout.
//
// Desabilitado tem tom próprio e nunca é verde: um verde que significa "não sei"
// é exatamente a mentira que a seção 11 proíbe.
func tomDoEstado(e Estado, habilitado, supervisionado bool) webui.Tom {
	if !habilitado || !supervisionado {
		return webui.TomNeutro
	}
	switch e {
	case EstadoPronto:
		return webui.TomSucesso
	case EstadoDegradado, EstadoSondaFalhou, EstadoDesabilitado:
		return webui.TomPerigo
	case EstadoConectando, EstadoNovo, EstadoSemConsentimento:
		return webui.TomAlerta
	default:
		return webui.TomNeutro
	}
}

func rotuloDoEstado(e Estado, habilitado, supervisionado bool) string {
	if !habilitado {
		return "desabilitado"
	}
	if !supervisionado {
		return "fora da supervisão"
	}
	switch e {
	case EstadoPronto:
		return "pronto"
	case EstadoDegradado:
		return "degradado"
	case EstadoConectando:
		return "conectando"
	case EstadoNovo:
		return "iniciando"
	case EstadoDesabilitado:
		return "desabilitado por autoproteção"
	case EstadoSondaFalhou:
		return "sonda falhou"
	case EstadoSemConsentimento:
		return "sem consentimento"
	default:
		return string(e)
	}
}

func instante(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return t.Local().Format("02/01/2006 15:04:05")
}

// proximaTentativa descreve o agendamento do backoff em texto curto.
//
// Prazo relativo e não só o horário: "em 8s" responde a pergunta que o admin
// tem na frente da tela sem ele precisar calcular a diferença.
func proximaTentativa(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	falta := time.Until(t).Round(time.Second)
	if falta <= 0 {
		return "agora"
	}
	return "em " + falta.String() + " (" + instante(t) + ")"
}

// TelaLista é a lista de upstreams.
templ TelaLista(linhas []Linha, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "MCPs",
		Subtitulo: "Cada MCP é um servidor externo que o patchbay consome. Ele mantém uma sessão por MCP, aberta fora do caminho da requisição do cliente.",
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      botaoNovo(),
		Alerta:    alerta,
	}) {
		if len(linhas) == 0 {
			@webui.Vazio("Nenhum MCP ainda.",
				"Cadastre o primeiro servidor MCP que o patchbay vai agregar: um servidor Streamable HTTP, um servidor SSE legado, ou um processo local que fala MCP pelo stdin e stdout. Se a documentação dele publica uma linha de instalação do claude mcp add, cole-a e o patchbay preenche o cadastro.") {
				@botaoNovo()
			}
		} else {
			@webui.Cartao("") {
				@webui.Tabela("MCPs cadastrados, com estado da sessão e ferramentas") {
					<thead class="border-b border-borda bg-superficie-alta text-xs uppercase tracking-wide text-conteudo-suave">
						<tr>
							<th scope="col" class="px-4 py-2.5 font-semibold">MCP</th>
							<th scope="col" class="px-4 py-2.5 font-semibold">Estado</th>
							<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Ferramentas</th>
							<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Endpoints</th>
							<th scope="col" class="px-4 py-2.5 font-semibold">Próxima tentativa</th>
							<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Timeout</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-borda">
						for _, l := range linhas {
							<tr class="transition-colors duration-150 ease-out hover:bg-superficie-alta">
								<td class="px-4 py-3">
									<a href={ templ.SafeURL(rotaDo(l.ID)) } class="pb-link font-medium">{ l.Nome }</a>
									<p class="mt-0.5 flex items-center gap-2">
										@webui.Selo(webui.TomNeutro, rotuloDoTipo(l.Tipo))
									</p>
									<p class="max-w-[48ch] truncate font-mono text-xs text-conteudo-tenue" title={ l.Descricao() }>{ l.Descricao() }</p>
								</td>
								<td class="px-4 py-3">
									@webui.Selo(tomDoEstado(l.Estado, l.Habilitado, l.Supervisionado),
										rotuloDoEstado(l.Estado, l.Habilitado, l.Supervisionado))
									if l.UltimoErro != "" {
										<p class="mt-1 max-w-[40ch] truncate text-xs text-perigo" title={ l.UltimoErro }>{ l.UltimoErro }</p>
									}
								</td>
								<td class="px-4 py-3" data-numero>{ strconv.Itoa(l.Ferramentas) }</td>
								<td class="px-4 py-3" data-numero>{ strconv.Itoa(l.Endpoints) }</td>
								<td class="px-4 py-3 text-sm text-conteudo-suave">
									{ proximaTentativa(l.ProximaEm) }
									if l.Abandonos > 0 {
										<p class="mt-1 text-xs text-conteudo-tenue">{ strconv.Itoa(l.Abandonos) } connect(s) abandonado(s)</p>
									}
									if l.AbandonosTotais > l.Abandonos {
										<p class="text-xs text-conteudo-tenue">{ strconv.Itoa(l.AbandonosTotais) } no total</p>
									}
								</td>
								<td class="px-4 py-3" data-numero>{ strconv.FormatInt(l.TimeoutMS, 10) } ms</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

// botaoNovo oferece os três tipos como ações separadas, mais o atalho de colar
// o comando de instalação.
//
// O tipo é escolhido aqui e não dentro do formulário porque ele não muda depois:
// HTTP, SSE e STDIO pedem campos diferentes, e um formulário com os três
// conjuntos ao mesmo tempo obrigaria o admin a adivinhar quais valem.
//
// Colar o comando é a ação primária, e os três tipos ficam secundários: quase
// todo servidor MCP publica a instalação como uma linha de `claude mcp add`, e
// transcrever aquela linha campo a campo é onde nascem o transporte errado e o
// header com nome trocado. Quem não tem o comando continua com os três botões.
templ botaoNovo() {
	<div class="flex flex-wrap items-center gap-2">
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoSTDIO) } class="pb-botao pb-botao-secundario">Novo processo STDIO</a>
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoSSE) } class="pb-botao pb-botao-secundario">Novo MCP SSE</a>
		<a href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoHTTP) } class="pb-botao pb-botao-secundario">Novo MCP HTTP</a>
		<a href={ templ.SafeURL(rotaImportar()) } class="pb-botao pb-botao-primario">Colar comando de instalação</a>
	</div>
}

// rotuloDoTipo nomeia o transporte na tela.
func rotuloDoTipo(tipo string) string {
	switch tipo {
	case TipoSTDIO:
		return "processo stdio"
	case TipoSSE:
		return "sse"
	default:
		return "streamable http"
	}
}

// TelaDetalhe mostra o estado atual e as ferramentas descobertas.
templ TelaDetalhe(d Detalhe, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    d.Nome,
		Subtitulo: rotuloDoTipo(d.Tipo) + " · " + d.Descricao(),
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      acoesDoDetalhe(d),
		Alerta:    alerta,
	}) {
		<div class="flex flex-col gap-6">
			@webui.Cartao("Estado") {
				<dl class="grid gap-x-6 gap-y-4 px-4 py-4 sm:grid-cols-2 lg:grid-cols-4">
					if !d.STDIO() {
						@dado("Modo de credencial") {
							@webui.Selo(webui.TomNeutro, rotuloDoModo(d.ModoEfetivo()))
						}
					}
					@dado("Situação") {
						@webui.Selo(tomDoEstado(d.Estado, d.Habilitado, d.Supervisionado),
							rotuloDoEstado(d.Estado, d.Habilitado, d.Supervisionado))
					}
					@dado("Ferramentas descobertas") {
						<span data-numero>{ strconv.Itoa(len(d.Ferramentas)) }</span>
					}
					@dado("Timeout de toda operação") {
						<span data-numero>{ strconv.FormatInt(d.TimeoutMS, 10) } ms</span>
					}
					@dado("Última tentativa") {
						{ instante(d.TentativaEm) }
					}
					@dado("Próxima tentativa") {
						{ proximaTentativa(d.ProximaEm) }
					}
					@dado("Falhas consecutivas") {
						<span data-numero>{ strconv.Itoa(d.Falhas) }</span>
					}
					@dado("Connects abandonados") {
						<span data-numero>{ strconv.Itoa(d.Abandonos) }</span>
						if d.TetoAbandonos > 0 {
							<span class="text-conteudo-tenue">de { strconv.Itoa(d.TetoAbandonos) }</span>
						}
						if d.AbandonosTotais > d.Abandonos {
							<span class="ml-2 text-xs text-conteudo-tenue">({ strconv.Itoa(d.AbandonosTotais) } no total acumulado)</span>
						}
					}
				</dl>
				if d.Motivo != "" {
					<div class="border-t border-borda px-4 py-4">
						<p class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">Por que a supervisão parou</p>
						<p class="mt-1 max-w-[80ch] text-sm text-perigo">{ d.Motivo }</p>
						<p class="mt-2 max-w-[65ch] text-sm text-conteudo-suave">
							Nada disso foi gravado no banco: o único estado persistido é o de
							<em>habilitado</em>. Reiniciar o patchbay, ou clicar em Reconectar, recomeça a
							máquina em <em>novo</em>.
						</p>
					</div>
				}
				if d.UltimoErro != "" {
					<div class="border-t border-borda px-4 py-4">
						<p class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">Último erro</p>
						<p class="mt-1 max-w-[80ch] break-words font-mono text-sm text-perigo">{ d.UltimoErro }</p>
						<p class="mt-2 max-w-[65ch] text-sm text-conteudo-suave">
							O MCP continua na lista com o motivo à vista, e a supervisão tenta de novo
							quando o backoff vencer — exponencial com jitter e teto, para que a frequência de
							tentativa caia enquanto o servidor não volta. O erro vive em memória: o banco
							guarda só a intenção de habilitar.
						</p>
					</div>
				}
			}
			if d.STDIO() {
				@webui.Cartao("Processo") {
					<div class="flex flex-col gap-4 px-4 py-4">
						<p class="max-w-[65ch] text-sm text-conteudo-suave">
							Um processo por MCP, compartilhado por todas as sessões de cliente. Ele nasce
							numa árvore própria do sistema operacional — <em>process group</em> no Linux e no
							macOS, <em>Job Object</em> no Windows —, e ao encerrar morre a árvore inteira,
							inclusive o neto que o programa tenha lançado. Matar só o filho direto é o que
							vaza processo até esgotar os PIDs da máquina.
						</p>
						<dl class="grid gap-x-6 gap-y-4">
							@dado("Linha de comando") {
								<code class="block max-w-[80ch] break-all font-mono text-sm">{ LinhaDeComando(d.Comando, d.Args) }</code>
							}
							@dado("Argumentos") {
								if len(d.Args) == 0 {
									<span class="text-conteudo-tenue">nenhum</span>
								} else {
									<ol class="flex flex-col gap-1">
										for _, a := range d.Args {
											<li><code class="font-mono text-xs">{ a }</code></li>
										}
									</ol>
								}
							}
							@dado("Variáveis de ambiente") {
								if len(d.VariaveisEmClaro()) == 0 {
									<span class="text-conteudo-tenue">nenhuma além do ambiente do patchbay</span>
								} else {
									<ul class="flex flex-col gap-1">
										for _, p := range d.VariaveisEmClaro() {
											<li><code class="font-mono text-xs">{ p.Nome }={ p.Valor }</code></li>
										}
									</ul>
								}
							}
						</dl>
						<p class="max-w-[65ch] text-sm text-conteudo-tenue">
							O processo herda o ambiente do patchbay e recebe estas variáveis por cima, mais as
							cifradas listadas abaixo. Sem a herança, um servidor lançado por
							<code class="font-mono">npx</code> ou <code class="font-mono">uvx</code> não acharia
							nem o próprio interpretador.
						</p>
					</div>
				}
			}
			@webui.Cartao("Ferramentas descobertas") {
				if len(d.Ferramentas) == 0 {
					<p class="px-4 py-6 max-w-[65ch] text-conteudo-suave">
						Nenhuma ferramenta no último <code class="font-mono">tools/list</code> bem-sucedido.
						if !d.Habilitado {
							O MCP está desabilitado, então não há sessão aberta.
						} else if d.Estado == EstadoDegradado {
							O MCP está degradado: as ferramentas saem do catálogo enquanto ele não responde,
							porque ferramenta que não funciona custa contexto no cliente sem entregar nada.
							Os endpoints continuam servindo o que os outros MCPs trazem, e as ferramentas
							que saíram ainda respondem por uma janela de graça explicando que saíram.
						} else if d.Estado == EstadoDesabilitado {
							A supervisão se desligou sozinha ao passar do teto de connects abandonados.
							Use Reconectar quando o servidor voltar a responder.
						} else if d.Estado == EstadoSondaFalhou {
							A sonda falhou: o servidor conversa e lista ferramentas, mas a chamada de
							verdade não funciona. Enquanto isso durar, o último tools/list fica guardado
							em memória e não é servido a ninguém.
						} else {
							A supervisão ainda está conectando.
						}
					</p>
				} else {
					@webui.Tabela("Ferramentas deste MCP, com o nome exposto ao cliente") {
						<thead class="border-b border-borda bg-superficie-alta text-xs uppercase tracking-wide text-conteudo-suave">
							<tr>
								<th scope="col" class="px-4 py-2.5 font-semibold">Nome exposto</th>
								<th scope="col" class="px-4 py-2.5 font-semibold">Nome no MCP</th>
								<th scope="col" class="px-4 py-2.5 font-semibold">Descrição</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-borda">
							for _, f := range d.Ferramentas {
								<tr>
									<td class="px-4 py-3 align-top">
										<code class="font-mono text-sm">{ f.NomeExposto }</code>
										if len(f.Avisos) > 0 {
											<p class="mt-1 flex flex-wrap gap-1">
												for _, aviso := range f.Avisos {
													@webui.Selo(webui.TomAlerta, strings.ReplaceAll(aviso, "_", " "))
												}
											</p>
										}
									</td>
									<td class="px-4 py-3 align-top">
										<code class="font-mono text-sm text-conteudo-suave">{ f.NomeOriginal }</code>
									</td>
									<td class="max-w-[60ch] px-4 py-3 align-top text-conteudo-suave">
										if f.Descricao == "" {
											<span class="text-conteudo-tenue">sem descrição</span>
										} else {
											{ f.Descricao }
										}
									</td>
								</tr>
							}
						</tbody>
					}
				}
			}
			@cartaoSonda(d)
			if d.UsaOAuth() {
				@cartaoOAuth(d)
			}
			@webui.Cartao("Credenciais apresentadas ao MCP") {
				<div class="flex flex-col gap-4 px-4 py-4">
					<p class="max-w-[65ch] text-sm text-conteudo-suave">
						O que o patchbay apresenta ao MCP fica cifrado em repouso (AES-256-GCM, chave
						derivada da chave mestra). O valor não volta para esta tela nem para o log — o que
						aparece aqui é só se ele está definido. Para trocar, edite o MCP.
					</p>
					<dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
						if d.STDIO() {
							@dado("Variáveis de ambiente cifradas") {
								if len(d.VariaveisSecretas()) == 0 {
									<span class="text-conteudo-tenue">nenhuma</span>
								} else {
									<ul class="flex flex-wrap gap-2">
										for _, v := range d.VariaveisSecretas() {
											<li class="flex items-center gap-2 rounded-md bg-superficie-alta px-2 py-1">
												<code class="font-mono text-xs">{ v.Nome }</code>
												@webui.Selo(webui.TomSucesso, "definida")
											</li>
										}
									</ul>
								}
							}
						} else {
							@dado("Bearer") {
								if d.TemBearer() {
									@webui.Selo(webui.TomSucesso, "definido")
								} else {
									@webui.Selo(webui.TomNeutro, "não definido")
								}
							}
							@dado("Headers estáticos") {
								if len(d.HeadersEstaticos()) == 0 {
									<span class="text-conteudo-tenue">nenhum</span>
								} else {
									<ul class="flex flex-wrap gap-2">
										for _, h := range d.HeadersEstaticos() {
											<li class="flex items-center gap-2 rounded-md bg-superficie-alta px-2 py-1">
												<code class="font-mono text-xs">{ h.Nome }</code>
												@webui.Selo(webui.TomSucesso, "definido")
											</li>
										}
									</ul>
								}
							}
						}
					</dl>
				</div>
			}
			@webui.Cartao("Endpoints que incluem este MCP") {
				if len(d.Endpoints) == 0 {
					<p class="px-4 py-6 max-w-[65ch] text-conteudo-suave">
						Nenhum endpoint inclui este MCP, então as ferramentas dele não chegam a cliente nenhum.
						Edite um endpoint para compô-lo.
					</p>
				} else {
					<ul class="flex flex-wrap gap-2 px-4 py-4">
						for _, slug := range d.Endpoints {
							<li class="rounded-md bg-superficie-alta px-2 py-1 font-mono text-xs text-conteudo-suave">{ slug }</li>
						}
					</ul>
				}
			}
		</div>
	}
}

// rotuloDaSonda é o estado da sonda em texto. "desligada" é estado próprio e
// nunca verde: um verde que significa "não sei" é exatamente a mentira que a
// sonda existe para acabar (seção 11).
func rotuloDaSonda(d Detalhe) string {
	switch {
	case !d.SondaLigada():
		return "desligada"
	case d.Estado == EstadoSondaFalhou:
		return "falhando"
	case d.SondaAtual.OKEm.IsZero():
		return "sem sondagem ainda"
	case d.SondaAtual.Falhas > 0:
		return "falhou a última"
	default:
		return "passando"
	}
}

func tomDaSonda(d Detalhe) webui.Tom {
	switch {
	case !d.SondaLigada():
		return webui.TomNeutro
	case d.Estado == EstadoSondaFalhou:
		return webui.TomPerigo
	case d.SondaAtual.Falhas > 0:
		return webui.TomAlerta
	case d.SondaAtual.OKEm.IsZero():
		return webui.TomAlerta
	default:
		return webui.TomSucesso
	}
}

// milissegundos formata uma duração como o número que o formulário guarda.
func milissegundos(d time.Duration) string {
	return strconv.FormatInt(d.Milliseconds(), 10) + " ms"
}

// cartaoSonda é a sonda funcional na tela do upstream.
//
// Ele aparece mesmo com a sonda desligada, e de propósito: a maioria dos
// upstreams vai ficar sem sonda porque configurar dá trabalho, e o valor do
// diferencial é proporcional à disciplina de configurar (seção 13). Um cartão
// que só existe quando alguém já configurou não lembraria ninguém disso.
templ cartaoSonda(d Detalhe) {
	@webui.Cartao("Sonda de saúde funcional") {
		<dl class="grid gap-x-6 gap-y-4 px-4 py-4 sm:grid-cols-2 lg:grid-cols-4">
			@dado("Sonda") {
				@webui.Selo(tomDaSonda(d), rotuloDaSonda(d))
			}
			@dado("Ferramenta sondada") {
				if d.Sonda.Ferramenta == "" {
					<span class="text-conteudo-tenue">nenhuma escolhida</span>
				} else {
					<code class="font-mono text-xs break-all">{ d.Sonda.Ferramenta }</code>
				}
			}
			@dado("Intervalo") {
				<span data-numero>{ milissegundos(d.Sonda.Intervalo) }</span>
			}
			@dado("Timeout da sondagem") {
				<span data-numero>{ milissegundos(d.Sonda.Timeout) }</span>
			}
			@dado("Última sondagem") {
				{ instante(d.SondaAtual.Em) }
			}
			@dado("Última que passou") {
				{ instante(d.SondaAtual.OKEm) }
			}
			@dado("Falhas seguidas") {
				<span data-numero>{ strconv.Itoa(d.SondaAtual.Falhas) }</span>
				<span class="text-conteudo-tenue">de { strconv.Itoa(d.Sonda.Normalizada().Tolerancia) }</span>
			}
			@dado("Ferramentas no catálogo") {
				<span data-numero>{ strconv.Itoa(d.NoCatalogo) }</span>
				if len(d.Ferramentas) != d.NoCatalogo {
					<span class="ml-2 text-xs text-conteudo-tenue">({ strconv.Itoa(len(d.Ferramentas)) } descobertas)</span>
				}
			}
		</dl>
		if !d.SondaLigada() {
			<div class="border-t border-borda px-4 py-4">
				<p class="max-w-[75ch] text-sm text-conteudo-suave">
					A sonda é <strong>opt-in</strong> e vem desligada. Sem ela, "pronto" quer dizer só que
					o servidor conversa e lista ferramentas — não que chamá-las funcione. Ligue-a na
					edição escolhendo uma ferramenta <em>inócua</em>: o patchbay não tem como saber que
					<code class="font-mono">send_message</code> manda mensagem para alguém, e adivinhar
					seria a forma de descobrir isso do pior jeito.
				</p>
			</div>
		} else {
			<div class="border-t border-borda px-4 py-4">
				<dl class="flex flex-col gap-4">
					@dado("Requisição exata") {
						<code class="block max-w-[80ch] break-all font-mono text-xs">{ ouTracoSonda(d.SondaAtual.Pedido) }</code>
					}
					@dado("Resposta exata") {
						if d.SondaAtual.Resposta == "" {
							<span class="text-conteudo-tenue">—</span>
						} else {
							<pre class="max-w-[80ch] overflow-x-auto whitespace-pre-wrap break-words rounded-md bg-superficie-alta px-3 py-2 font-mono text-xs text-conteudo-suave">{ d.SondaAtual.Resposta }</pre>
						}
					}
				</dl>
				if d.SondaAtual.Erro != "" {
					<p class="mt-4 text-xs font-semibold uppercase tracking-wide text-conteudo-suave">Erro da última sondagem</p>
					<p class="mt-1 max-w-[80ch] break-words font-mono text-sm text-perigo">{ d.SondaAtual.Erro }</p>
				}
				<p class="mt-3 max-w-[75ch] text-sm text-conteudo-suave">
					A requisição e a resposta ficam aqui porque sem as duas exatas não dá para separar
					"minha sonda está mal configurada" de "o servidor está quebrado" — e a saída mais
					fácil passa a ser desligar a sonda em vez de consertar o servidor. As duas vivem
					só em memória: nada da sonda além da configuração vai ao banco, e todo boot
					recomeça em <em>novo</em>.
				</p>
			</div>
		}
	}
}

// ouTracoSonda evita o campo vazio na evidência da sonda.
func ouTracoSonda(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// cartaoOAuth mostra o consentimento sem mostrar nada do token.
//
// Nenhum campo aqui é segredo nem exige decifrar: client_id não é credencial, e
// o que interessa do token é se existe e quando vence. É o que faz esta tela
// continuar abrindo depois de uma troca de chave mestra — justamente quando ela
// é mais necessária.
templ cartaoOAuth(d Detalhe) {
	@webui.Cartao("Consentimento OAuth") {
		<dl class="grid gap-x-6 gap-y-4 px-4 py-4 sm:grid-cols-2 lg:grid-cols-4">
			@dado("Consentimento") {
				if d.OAuth.Consentido {
					@webui.Selo(webui.TomSucesso, "concedido")
				} else {
					@webui.Selo(webui.TomAlerta, "pendente")
				}
			}
			@dado("Registro de cliente") {
				{ d.RotuloDoRegistro() }
			}
			@dado("Token expira em") {
				{ instante(d.OAuth.ExpiraEm) }
			}
			@dado("Último refresh") {
				{ instante(d.OAuth.RefreshEm) }
			}
			@dado("client_id informado") {
				if d.OAuth.ClientID == "" {
					<span class="text-conteudo-tenue">nenhum — CIMD ou registro dinâmico</span>
				} else {
					<code class="font-mono text-xs break-all">{ d.OAuth.ClientID }</code>
				}
			}
			@dado("client_id em uso") {
				if d.OAuth.ClientIDEfetivo == "" {
					<span class="text-conteudo-tenue">—</span>
				} else {
					<code class="font-mono text-xs break-all">{ d.OAuth.ClientIDEfetivo }</code>
				}
			}
			@dado("client_secret") {
				if d.OAuth.SegredoDefinido {
					@webui.Selo(webui.TomSucesso, "definido")
				} else {
					@webui.Selo(webui.TomNeutro, "cliente público")
				}
			}
			@dado("issuer conferido") {
				if d.OAuth.Issuer == "" {
					<span class="text-conteudo-tenue">não confere</span>
				} else {
					<code class="font-mono text-xs break-all">{ d.OAuth.Issuer }</code>
				}
			}
		</dl>
		<div class="border-t border-borda px-4 py-4">
			<p class="max-w-[75ch] text-sm text-conteudo-suave">
				if d.Estado == EstadoSemConsentimento {
					Enquanto o consentimento falta, a supervisão não fica tentando: reconectar só
					para tomar 401 não resolve nada, e o que falta é o clique. Use
					<em>Autorizar</em> acima — a reconexão acontece na hora, sem esperar o backoff.
				} else if d.OAuth.Consentido {
					O token é renovado na supervisão, com antecedência, e nunca no caminho da
					requisição de um cliente. Access e refresh token ficam cifrados em repouso e
					não voltam para esta tela nem para o log.
				} else {
					Salve o MCP, clique em <em>Autorizar</em> e conclua o consentimento no
					provedor. O código volta para
					<code class="font-mono">{ webui.RotaCallbackOAuthUpstream }</code>, e a troca por
					token acontece na supervisão.
				}
			</p>
		</div>
	}
}

func botaoDeAutorizar(d Detalhe) string {
	if d.OAuth.Consentido {
		return "pb-botao pb-botao-secundario"
	}
	return "pb-botao pb-botao-primario"
}

templ acoesDoDetalhe(d Detalhe) {
	<div class="flex items-center gap-2">
		if d.PodeAutorizar() {
			<form
				method="post"
				action={ templ.SafeURL(rotaDo(d.ID) + "/autorizar") }
			>
				<button type="submit" class={ botaoDeAutorizar(d) }>
					if d.OAuth.Consentido {
						Reautorizar
					} else {
						Autorizar
					}
				</button>
			</form>
		}
		if d.PodeSondar() {
			<form
				method="post"
				action={ templ.SafeURL(rotaDo(d.ID) + "/sondar") }
				hx-post={ rotaDo(d.ID) + "/sondar" }
				hx-disabled-elt="find button"
			>
				@webui.BotaoAcao("pb-botao-secundario", "Sondar agora", "Sondando…")
			</form>
		}
		if d.Habilitado {
			<form
				method="post"
				action={ templ.SafeURL(rotaDo(d.ID) + "/reconectar") }
				hx-post={ rotaDo(d.ID) + "/reconectar" }
				hx-disabled-elt="find button"
			>
				@webui.BotaoAcao("pb-botao-secundario", "Reconectar", "Reconectando…")
			</form>
		}
		<form
			method="post"
			action={ templ.SafeURL(rotaDo(d.ID) + "/remover") }
			hx-post={ rotaDo(d.ID) + "/remover" }
			hx-confirm={ avisoDeRemocao(d) }
			hx-disabled-elt="find button"
		>
			@webui.BotaoAcao("pb-botao-perigo", "Remover", "Removendo…")
		</form>
		<a href={ templ.SafeURL(rotaDo(d.ID) + "/editar") } class="pb-botao pb-botao-primario">Editar</a>
	</div>
}

func avisoDeRemocao(d Detalhe) string {
	base := "Remover o MCP " + d.Nome + "? A sessão é fechada na hora."
	if len(d.Endpoints) == 0 {
		return base
	}
	return base + " As ferramentas dele saem de " + strconv.Itoa(len(d.Endpoints)) +
		" endpoint(s): " + strings.Join(d.Endpoints, ", ") + "."
}

templ dado(rotulo string) {
	<div>
		<dt class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">{ rotulo }</dt>
		<dd class="mt-1 text-conteudo">
			{ children... }
		</dd>
	</div>
}

// TelaForm serve a criação e a edição de upstream, HTTP ou STDIO.
//
// O tipo viaja em campo escondido e não em seletor: ele é escolhido na criação e
// não muda depois. Trocar o transporte de um upstream vivo não é editá-lo, é
// substituí-lo — outras ferramentas, outras credenciais, outro modo de falha.
templ TelaForm(f Form) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    tituloDoForm(f),
		Subtitulo: subtituloDoForm(f),
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
	}) {
		<form method="post" action={ templ.SafeURL(acaoDoForm(f)) } class="flex max-w-2xl flex-col gap-8">
			<input type="hidden" name="tipo" value={ f.TipoEfetivo() }/>
			@webui.Cartao(tituloDaConexao(f)) {
				<div class="flex flex-col gap-6 px-4 py-5">
					@webui.Campo(webui.DadosCampo{
						Nome:        "nome",
						Rotulo:      "Nome",
						Valor:       f.Nome,
						Ajuda:       "Como o MCP aparece nesta administração e no log.",
						Erro:        f.Erros["nome"],
						Obrigatorio: true,
					})
					if f.STDIO() {
						@webui.Campo(webui.DadosCampo{
							Nome:         "comando",
							Rotulo:       "Comando",
							Valor:        f.Comando,
							Ajuda:        "O programa a executar, resolvido pelo PATH do processo patchbay. Por exemplo npx, uvx, node ou um caminho completo.",
							Erro:         f.Erros["comando"],
							Obrigatorio:  true,
							Monoespacado: true,
							Placeholder:  "npx",
						})
						@webui.CampoTexto(webui.DadosCampo{
							Nome:        "args",
							Rotulo:      "Argumentos",
							Valor:       f.ArgsTexto,
							Ajuda:       "Um argumento por linha. Nada de linha de comando partida por espaço: argumento com espaço dentro é normal, e um separador escolhido aqui viraria uma regra de escape para você descobrir errando.",
							Erro:        f.Erros["args"],
							Placeholder: "-y\n@modelcontextprotocol/server-filesystem\nC:\\dados",
						})
						@webui.CampoTexto(webui.DadosCampo{
							Nome:        "env",
							Rotulo:      "Variáveis de ambiente (não sensíveis)",
							Valor:       f.EnvTexto,
							Ajuda:       "NOME=valor, uma por linha. Vão em claro no banco e aparecem na tela — é o lugar de PATH extra e nível de log, nunca de token. Segredo vai no bloco cifrado abaixo.",
							Erro:        f.Erros["env"],
							Placeholder: "NODE_ENV=production",
						})
					} else {
						@webui.Campo(webui.DadosCampo{
							Nome:         "url",
							Rotulo:       "URL do endpoint MCP",
							Tipo:         "url",
							Valor:        f.URL,
							Ajuda:        ajudaDaURL(f),
							Erro:         f.Erros["url"],
							Obrigatorio:  true,
							Monoespacado: true,
							Placeholder:  marcadorDaURL(f),
						})
					}
					@webui.Campo(webui.DadosCampo{
						Nome:         "timeout_ms",
						Rotulo:       "Timeout (ms)",
						Tipo:         "number",
						Valor:        strconv.FormatInt(f.TimeoutMS, 10),
						Ajuda:        "Vale para conectar, listar e chamar ferramenta neste MCP. Entre 250 e 120000.",
						Erro:         f.Erros["timeout_ms"],
						Obrigatorio:  true,
						Monoespacado: true,
					})
					<label class="flex items-start gap-3">
						<input
							type="checkbox"
							name="habilitado"
							value="1"
							class="mt-0.5 h-4 w-4 accent-[var(--pb-acento)]"
							checked?={ f.Habilitado }
						/>
						<span>
							<span class="text-sm font-medium text-conteudo">Habilitado</span>
							<span class="block text-sm text-conteudo-tenue">
								Desmarcar fecha a sessão na hora e tira as ferramentas dos endpoints, sem apagar o cadastro.
							</span>
						</span>
					</label>
				</div>
			}
			@webui.Cartao("Credenciais") {
				<div class="flex flex-col gap-6 px-4 py-5">
					<p class="max-w-[65ch] text-sm text-conteudo-suave">
						O que o patchbay <strong>apresenta</strong> ao MCP é cifrado em repouso com
						AES-256-GCM e nunca é reexibido aqui. Campo em branco mantém o valor gravado;
						para tirar a credencial, marque <em>limpar</em>.
					</p>
					if f.STDIO() {
						<fieldset class="flex flex-col gap-3">
							<legend class="text-sm font-medium text-conteudo">Variáveis de ambiente sensíveis</legend>
							if f.Erros["env_secreto"] != "" {
								<p class="text-sm text-perigo">{ f.Erros["env_secreto"] }</p>
							}
							for i, e := range f.EnvSecretos {
								@linhaEnv(i, e)
							}
							<p class="text-sm text-conteudo-tenue">
								O token de um servidor lançado por linha de comando é a mesma classe de segredo
								que o bearer de um servidor HTTP: vai cifrado, e entra no bloco de ambiente do
								processo na hora de iniciá-lo.
							</p>
						</fieldset>
					} else {
						@credenciaisHTTP(f)
					}
				</div>
			}
			@cartaoDaSonda(f)
			<div class="flex items-center gap-3">
				<button type="submit" class="pb-botao pb-botao-primario">
					if f.ID == 0 {
						Criar MCP
					} else {
						Salvar
					}
				</button>
				<a href={ templ.SafeURL(webui.RotaUpstreams) } class="pb-botao pb-botao-secundario">Cancelar</a>
			</div>
		</form>
	}
}

// cartaoDaSonda é o bloco de configuração da sonda funcional.
//
// Ele fica no formulário dos dois tipos de upstream: a sonda é um tools/call, e
// um tools/call é a mesma coisa por HTTP, por SSE e por STDIO.
templ cartaoDaSonda(f Form) {
	@webui.Cartao("Sonda de saúde funcional") {
		<div class="flex flex-col gap-6 px-4 py-5">
			<p class="max-w-[65ch] text-sm text-conteudo-suave">
				A sonda executa um <code class="font-mono">tools/call</code> de verdade, de tempos em
				tempos, para saber se o servidor <strong>funciona</strong> — e não só se ele responde.
				Falhar tira as ferramentas deste MCP do catálogo de todos os endpoints, com
				lápide, e põe o MCP em <code class="font-mono">sonda_falhou</code>.
			</p>
			<label class="flex items-start gap-3">
				<input
					type="checkbox"
					name="sonda_habilitada"
					value="1"
					class="mt-0.5 h-4 w-4 accent-[var(--pb-acento)]"
					checked?={ f.SondaHabilitada }
				/>
				<span>
					<span class="text-sm font-medium text-conteudo">Sondar este MCP</span>
					<span class="block text-sm text-conteudo-tenue">
						Vem desligada. Uma sonda mal configurada apaga as ferramentas de um servidor
						saudável, então escolha uma ferramenta <em>inócua</em>: uma busca com um termo
						bobo é segura, e nada garante isso para uma ferramenta arbitrária.
					</span>
				</span>
			</label>
			@webui.Campo(webui.DadosCampo{
				Nome:         "sonda_ferramenta",
				Rotulo:       "Ferramenta a chamar",
				Valor:        f.SondaFerramenta,
				Ajuda:        "O nome como o MCP o expõe, sem o prefixo de nenhum endpoint: a sonda fala com o servidor direto.",
				Erro:         f.Erros["sonda_ferramenta"],
				Monoespacado: true,
				Placeholder:  "nome_da_ferramenta",
			})
			if f.Erros["sonda_ferramenta"] == "" && f.AvisoSondaFerramenta != "" {
				// Não bloqueante, e por isso fora de DadosCampo.Erro: o catálogo em
				// memória pode estar desatualizado (upstream ainda reconectando),
				// e travar o salvamento por causa dele impediria corrigir o resto
				// do formulário.
				<p class="flex items-start gap-2 text-sm text-conteudo-suave">
					@webui.Selo(webui.TomAlerta, "fora do catálogo")
					{ f.AvisoSondaFerramenta }
				</p>
			}
			@webui.CampoTexto(webui.DadosCampo{
				Nome:        "sonda_args",
				Rotulo:      "Argumentos (JSON)",
				Valor:       f.SondaArgs,
				Ajuda:       "O objeto de argumentos do tools/call, como {\"query\": \"ping\"}. Em branco chama sem argumentos.",
				Erro:        f.Erros["sonda_args"],
				Placeholder: "{\"query\": \"ping\"}",
			})
			@webui.Campo(webui.DadosCampo{
				Nome:   "sonda_espera",
				Rotulo: "Trecho esperado na resposta (opcional)",
				Valor:  f.SondaEspera,
				Ajuda:  "Em branco, basta a chamada não dar erro. Preenchido, cobre o servidor que responde 200 com um erro amigável no corpo, sem marcar isError.",
			})
			<div class="grid gap-6 sm:grid-cols-3">
				@webui.Campo(webui.DadosCampo{
					Nome:         "sonda_intervalo_ms",
					Rotulo:       "Intervalo (ms)",
					Tipo:         "number",
					Valor:        strconv.FormatInt(f.SondaIntervaloMS, 10),
					Ajuda:        "A sonda consome cota da API do provedor: quem escolhe o intervalo é quem paga a cota.",
					Erro:         f.Erros["sonda_intervalo_ms"],
					Monoespacado: true,
				})
				@webui.Campo(webui.DadosCampo{
					Nome:         "sonda_timeout_ms",
					Rotulo:       "Timeout da sondagem (ms)",
					Tipo:         "number",
					Valor:        strconv.FormatInt(f.SondaTimeoutMS, 10),
					Ajuda:        "Cancela só a chamada da sonda, nunca a sessão do MCP.",
					Erro:         f.Erros["sonda_timeout_ms"],
					Monoespacado: true,
				})
				@webui.Campo(webui.DadosCampo{
					Nome:         "sonda_tolerancia",
					Rotulo:       "Falhas seguidas para derrubar",
					Tipo:         "number",
					Valor:        strconv.Itoa(f.SondaTolerancia),
					Ajuda:        "Quantas sondagens seguidas precisam falhar antes de as ferramentas saírem do catálogo.",
					Erro:         f.Erros["sonda_tolerancia"],
					Monoespacado: true,
				})
			</div>
		</div>
	}
}

// credenciaisHTTP é o bloco de credencial de um upstream HTTP ou SSE.
//
// Os dois modos não aparecem juntos, e é decisão e não limitação: bearer estático
// e OAuth montam o mesmo header Authorization, e uma tela que oferece os dois ao
// mesmo tempo convida a preencher os dois — o servidor então escolhe um sem dizer
// qual, e o sintoma é 401 intermitente que ninguém liga a este formulário.
// Trocar o modo e salvar recarrega a tela com os campos do outro, sem JavaScript.
templ credenciaisHTTP(f Form) {
	<div class="flex flex-col gap-6">
		if f.OAuthDisponivel {
			@seletorDeModo(f)
		}
		if f.UsaOAuth() {
			@credenciaisOAuth(f)
		} else {
			@credenciaisEstaticas(f)
		}
	</div>
}

// seletorDeModo escolhe entre credencial estática e OAuth.
templ seletorDeModo(f Form) {
	<fieldset class="flex flex-col gap-2">
		<legend class="text-sm font-medium text-conteudo">Modo de credencial</legend>
		if f.Erros["modo"] != "" {
			<p class="text-sm text-perigo">{ f.Erros["modo"] }</p>
		}
		<label class="flex items-start gap-3">
			<input
				type="radio"
				name="modo"
				value={ ModoEstatica }
				class="mt-0.5 h-4 w-4 accent-[var(--pb-acento)]"
				checked?={ !f.UsaOAuth() }
			/>
			<span>
				<span class="text-sm font-medium text-conteudo">Credencial estática</span>
				<span class="block text-sm text-conteudo-tenue">
					Bearer e headers colados por você. Não expira sozinho e não precisa de consentimento.
				</span>
			</span>
		</label>
		<label class="flex items-start gap-3">
			<input
				type="radio"
				name="modo"
				value={ ModoOAuth }
				class="mt-0.5 h-4 w-4 accent-[var(--pb-acento)]"
				checked?={ f.UsaOAuth() }
			/>
			<span>
				<span class="text-sm font-medium text-conteudo">OAuth (authorization code com PKCE)</span>
				<span class="block text-sm text-conteudo-tenue">
					O patchbay descobre o authorization server do MCP, você autoriza no navegador,
					e o token renovado fica cifrado em repouso. Salve primeiro; depois use
					<em>Autorizar</em> na tela do MCP.
				</span>
			</span>
		</label>
		<p class="text-sm text-conteudo-tenue">
			Trocar o modo e salvar recarrega o formulário com os campos do outro modo.
		</p>
	</fieldset>
}

// credenciaisOAuth é o bloco de cliente OAuth.
//
// client_id e client_secret aparecem como campo normal e não como recuperação de
// erro: o Google não anuncia registration_endpoint nem Client ID Metadata
// Document, então sem colar as duas coisas à mão ele simplesmente não funciona.
templ credenciaisOAuth(f Form) {
	<div class="flex flex-col gap-6">
		@webui.Campo(webui.DadosCampo{
			Nome:         "oauth_client_id",
			Rotulo:       "client_id (cliente pré-registrado)",
			Valor:        f.OAuthClientID,
			Ajuda:        "Deixe em branco para o patchbay tentar, nesta ordem, o Client ID Metadata Document dele e o registro dinâmico. Provedor que não suporta nenhum dos dois — o Google, por exemplo — exige colar aqui o client_id do cadastro.",
			Erro:         f.Erros["oauth_client_id"],
			Monoespacado: true,
		})
		<div class="flex flex-col gap-1.5">
			<div class="flex items-center gap-2">
				<label for="oauth_segredo" class="text-sm font-medium text-conteudo">client_secret</label>
				if f.OAuthSegredoDefinido {
					@webui.Selo(webui.TomSucesso, "definido")
				} else {
					@webui.Selo(webui.TomNeutro, "não definido")
				}
			</div>
			<input
				class="pb-campo font-mono"
				id="oauth_segredo"
				name="oauth_segredo"
				type="password"
				autocomplete="new-password"
				placeholder={ marcadorDeSegredo(f.OAuthSegredoDefinido) }
				if f.Erros["oauth_segredo"] != "" {
					aria-invalid="true"
				}
				aria-describedby="oauth-segredo-ajuda"
			/>
			if f.Erros["oauth_segredo"] != "" {
				<p id="oauth-segredo-ajuda" class="text-sm text-perigo">{ f.Erros["oauth_segredo"] }</p>
			} else {
				<p id="oauth-segredo-ajuda" class="text-sm text-conteudo-tenue">
					Cifrado em repouso, como toda credencial desta tela. Vazio significa cliente público,
					que é o certo quando o provedor não emite segredo.
				</p>
			}
			if f.OAuthSegredoDefinido {
				<label class="mt-1 flex items-center gap-2">
					<input type="checkbox" name="oauth_segredo_limpar" value="1" class="h-4 w-4 accent-[var(--pb-acento)]"/>
					<span class="text-sm text-conteudo-suave">Limpar o client_secret gravado</span>
				</label>
			}
		</div>
		@webui.Campo(webui.DadosCampo{
			Nome:         "oauth_issuer",
			Rotulo:       "issuer do authorization server (opcional)",
			Tipo:         "url",
			Valor:        f.OAuthIssuer,
			Ajuda:        "Preenchido, o patchbay recusa usar este client_id com um authorization server diferente — é a proteção contra confundir dois provedores. Só vale junto com client_id pré-registrado.",
			Erro:         f.Erros["oauth_issuer"],
			Monoespacado: true,
			Placeholder:  "https://accounts.google.com",
		})
		<p class="max-w-[65ch] text-sm text-conteudo-tenue">
			Registre no provedor exatamente este <code class="font-mono break-all">{ f.OAuthRedirectURI }</code>
			como <code class="font-mono">redirect_uri</code>. Ele é contrato — mudar a URL pública depois
			invalida o consentimento.
		</p>
	</div>
}

// credenciaisEstaticas é o bloco de bearer e headers estáticos.
templ credenciaisEstaticas(f Form) {
	<div class="flex flex-col gap-6">
		<div class="flex flex-col gap-1.5">
			<div class="flex items-center gap-2">
				<label for="bearer" class="text-sm font-medium text-conteudo">Bearer token</label>
				if f.BearerDefinido {
					@webui.Selo(webui.TomSucesso, "definido")
				} else {
					@webui.Selo(webui.TomNeutro, "não definido")
				}
			</div>
			<input
				class="pb-campo font-mono"
				id="bearer"
				name="bearer"
				type="password"
				autocomplete="new-password"
				placeholder={ marcadorDeSegredo(f.BearerDefinido) }
				if f.Erros["bearer"] != "" {
					aria-invalid="true"
				}
				aria-describedby="bearer-ajuda"
			/>
			if f.Erros["bearer"] != "" {
				<p id="bearer-ajuda" class="text-sm text-perigo">{ f.Erros["bearer"] }</p>
			} else {
				<p id="bearer-ajuda" class="text-sm text-conteudo-tenue">
					Vai como <code class="font-mono">Authorization: Bearer …</code> em toda requisição
					para este MCP.
				</p>
			}
			if f.BearerDefinido {
				<label class="mt-1 flex items-center gap-2">
					<input type="checkbox" name="bearer_limpar" value="1" class="h-4 w-4 accent-[var(--pb-acento)]"/>
					<span class="text-sm text-conteudo-suave">Limpar o bearer gravado</span>
				</label>
			}
		</div>
		<fieldset class="flex flex-col gap-3">
			<legend class="text-sm font-medium text-conteudo">Headers estáticos</legend>
			if f.Erros["headers"] != "" {
				<p class="text-sm text-perigo">{ f.Erros["headers"] }</p>
			}
			for i, h := range f.Headers {
				@linhaHeader(i, h)
			}
			<p class="text-sm text-conteudo-tenue">
				Um par nome/valor por linha, enviado em toda requisição.
				<code class="font-mono">Authorization</code> não entra aqui: use o campo de bearer acima.
			</p>
		</fieldset>
	</div>
}

// linhaEnv é uma linha da tabela de variáveis de ambiente cifradas.
//
// Mesma regra do linhaHeader: o nome de uma variável já gravada vai em campo
// escondido e aparece como texto, porque ele é a chave da linha no banco e do
// AAD da cifra — editá-lo criaria outra variável em vez de renomear esta.
templ linhaEnv(indice int, e CampoEnv) {
	<div class="flex flex-col gap-1.5 rounded-md border border-borda px-3 py-3">
		<div class="flex flex-wrap items-center gap-2">
			if e.Definido {
				<input type="hidden" name="env_nome" value={ e.Nome }/>
				<code class="font-mono text-sm text-conteudo">{ e.Nome }</code>
				@webui.Selo(webui.TomSucesso, "definida")
			} else {
				<input
					class="pb-campo font-mono sm:max-w-64"
					name="env_nome"
					type="text"
					value={ e.Nome }
					placeholder="GITHUB_TOKEN"
					aria-label={ "Nome da variável " + strconv.Itoa(indice+1) }
				/>
			}
		</div>
		<input
			class="pb-campo font-mono"
			name="env_valor"
			type="password"
			autocomplete="new-password"
			placeholder={ marcadorDeSegredo(e.Definido) }
			aria-label={ "Valor da variável " + strconv.Itoa(indice+1) }
			if e.Erro != "" {
				aria-invalid="true"
			}
		/>
		if e.Erro != "" {
			<p class="text-sm text-perigo">{ e.Erro }</p>
		}
		if e.Definido {
			<label class="flex items-center gap-2">
				<input type="checkbox" name="env_limpar" value={ e.Nome } class="h-4 w-4 accent-[var(--pb-acento)]"/>
				<span class="text-sm text-conteudo-suave">Limpar esta variável</span>
			</label>
		}
	</div>
}

// marcadorDeSegredo é o placeholder de um campo de segredo. Nunca o valor: o
// placeholder é o único texto de um campo de senha que a tela mostra.
func marcadorDeSegredo(definido bool) string {
	if definido {
		return "deixe em branco para manter o valor gravado"
	}
	return "cole o valor aqui"
}

// linhaHeader é uma linha da tabela de headers estáticos.
//
// O nome de um header já gravado vai em campo escondido e aparece como texto: é
// a chave da linha no banco e do AAD da cifra, e deixá-lo editável faria "trocar
// o nome" parecer renomear quando na verdade cria outro header.
templ linhaHeader(indice int, h CampoHeader) {
	<div class="flex flex-col gap-1.5 rounded-md border border-borda px-3 py-3">
		<div class="flex flex-wrap items-center gap-2">
			if h.Definido {
				<input type="hidden" name="header_nome" value={ h.Nome }/>
				<code class="font-mono text-sm text-conteudo">{ h.Nome }</code>
				@webui.Selo(webui.TomSucesso, "definido")
			} else {
				<input
					class="pb-campo font-mono sm:max-w-64"
					name="header_nome"
					type="text"
					value={ h.Nome }
					placeholder="X-Api-Key"
					aria-label={ "Nome do header " + strconv.Itoa(indice+1) }
				/>
			}
		</div>
		<input
			class="pb-campo font-mono"
			name="header_valor"
			type="password"
			autocomplete="new-password"
			placeholder={ marcadorDeSegredo(h.Definido) }
			aria-label={ "Valor do header " + strconv.Itoa(indice+1) }
			if h.Erro != "" {
				aria-invalid="true"
			}
		/>
		if h.Erro != "" {
			<p class="text-sm text-perigo">{ h.Erro }</p>
		}
		if h.Definido {
			<label class="flex items-center gap-2">
				<input type="checkbox" name="header_limpar" value={ h.Nome } class="h-4 w-4 accent-[var(--pb-acento)]"/>
				<span class="text-sm text-conteudo-suave">Limpar este header</span>
			</label>
		}
	</div>
}

func tituloDoForm(f Form) string {
	acao := "Editar"
	if f.ID == 0 {
		acao = "Novo"
	}
	switch f.TipoEfetivo() {
	case TipoSTDIO:
		return acao + " MCP STDIO"
	case TipoSSE:
		return acao + " MCP SSE"
	default:
		return acao + " MCP HTTP"
	}
}

func subtituloDoForm(f Form) string {
	switch f.TipoEfetivo() {
	case TipoSTDIO:
		return "Um processo local que fala MCP pelo stdin e stdout. O patchbay mantém um processo por MCP, " +
			"compartilhado por todas as sessões, e mata a árvore inteira ao encerrar. " +
			"Variáveis sensíveis são cifradas em repouso e nunca voltam para esta tela."
	case TipoSSE:
		return "O HTTP+SSE da revisão 2024-11-05 do MCP: um GET pendurado para os eventos do servidor e " +
			"um POST por mensagem do cliente. Mesmas credenciais do Streamable HTTP, cifradas em repouso " +
			"e nunca de volta para esta tela."
	default:
		return "MCP Streamable HTTP. Credenciais são cifradas em repouso e nunca voltam para esta tela."
	}
}

// ajudaDaURL e marcadorDaURL descrevem o endereço do tipo escolhido. O texto é
// diferente porque o endereço é diferente: no SSE legado a URL é a do stream de
// eventos, e é o servidor que anuncia depois onde os POSTs vão.
func ajudaDaURL(f Form) string {
	if f.TipoEfetivo() == TipoSSE {
		return "O endereço do stream de eventos, normalmente terminando em /sse. " +
			"O endereço dos POSTs vem no primeiro evento da sessão, não daqui."
	}
	return "O endereço Streamable HTTP do servidor, normalmente terminando em /mcp."
}

func marcadorDaURL(f Form) string {
	if f.TipoEfetivo() == TipoSSE {
		return "https://exemplo.com/sse"
	}
	return "https://exemplo.com/mcp"
}

func tituloDaConexao(f Form) string {
	if f.STDIO() {
		return "Processo"
	}
	return "Conexão"
}

// rotuloDoModo nomeia o modo de credencial na tela.
func rotuloDoModo(modo string) string {
	if modo == ModoOAuth {
		return "OAuth"
	}
	return "credencial estática"
}

func acaoDoForm(f Form) string {
	if f.ID == 0 {
		return webui.RotaUpstreams
	}
	return rotaDo(f.ID)
}
