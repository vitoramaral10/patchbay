package upstream

import "github.com/vitoramaral10/patchbay/internal/platform/webui"

// A caixa de colar o comando de instalação.
//
// Fica em arquivo próprio, e não em admin.templ, porque é um caminho de entrada
// à parte: não é o formulário de upstream com valores preenchidos, é um texto
// que o patchbay analisa e transforma em cadastro. O que grava é o texto,
// reanalisado no POST — a tela não monta campo nenhum.
//
// Até 2026-09-16 eram duas telas próprias (colar numa página, conferir noutra)
// e a criação vinha num terceiro passo. Viraram este cartão dentro da lista de
// MCPs: colar e salvar, por decisão do dono.

// rotaColar é a única rota do caminho de colar.
func rotaColar() string { return webui.RotaUpstreams + "/colar" }

// CaixaDeColar é o cartão de colar o comando, no topo da lista de MCPs.
templ CaixaDeColar(d DadosColar) {
	<section id="colar" class="scroll-mt-8">
		if d.Erro != "" {
			@webui.AlertaCaixa(webui.Alerta{
				Tom:    webui.TomPerigo,
				Titulo: "Não deu para usar este comando.",
				Texto:  d.Erro,
			})
		}
		@webui.Cartao("Adicionar colando o comando de instalação") {
			<form method="post" action={ templ.SafeURL(rotaColar()) } class="flex flex-col gap-4 px-4 py-5">
				@webui.CampoTexto(webui.DadosCampo{
					Nome:   "comando",
					Rotulo: "Comando",
					Valor:  d.Texto,
					Ajuda: "Uma linha de claude mcp add, com ou sem o executável na frente. " +
						"Pode vir quebrada em várias linhas, como na documentação. " +
						"O patchbay lê o transporte, a URL ou o processo, os headers e o token, " +
						"e cria o MCP direto.",
					Placeholder: "claude mcp add --transport http exemplo https://exemplo.com/mcp " +
						"--header \"Authorization: Bearer o-seu-token\"",
				})
				<p class="max-w-[65ch] text-sm text-conteudo-suave">
					O token vai cifrado para o banco e não volta para esta tela. Se o comando ainda
					tiver o exemplo da documentação no lugar do token — algo como
					<code class="font-mono">[your API token]</code> —, troque-o antes: gravado assim,
					o erro só apareceria como 401 dias depois.
				</p>
				<p class="max-w-[65ch] text-sm text-conteudo-suave">
					<strong>Comando de processo local é executado aqui.</strong> Uma linha que começa
					com <code class="font-mono">npx</code> ou <code class="font-mono">uvx</code> vira
					processo filho do patchbay, com o usuário deste processo, reiniciado pela
					supervisão sempre que cair. Não há tela de conferência antes: leia a linha antes
					de colar.
				</p>
				<div>
					<button type="submit" class="pb-botao pb-botao-primario">Criar MCP</button>
				</div>
			</form>
		}
	</section>
}
