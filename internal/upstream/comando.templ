package upstream

import "github.com/vitoramaral10/patchbay/internal/platform/webui"

// A caixa de colar o comando de instalação.
//
// Fica em arquivo próprio, e não em admin.templ, porque é um caminho de entrada
// à parte: não é o formulário de upstream com valores preenchidos, é um texto
// que o patchbay analisa e transforma em cadastro. O que grava é o texto,
// reanalisado no POST — a tela não monta campo nenhum.
//
// Até 2026-09-16 eram duas telas próprias (colar numa página, conferir noutra)
// e a criação vinha num terceiro passo. Viraram este cartão dentro da lista de
// MCPs: colar e salvar, por decisão do dono.

// rotaColar é a única rota do caminho de colar.
func rotaColar() string { return webui.RotaUpstreams + "/colar" }

// RotaAdicionar é a página de entrada de todo MCP novo.
const RotaAdicionar = webui.RotaUpstreams + "/adicionar"

// exemplosDeColar são o que a documentação de um servidor costuma mostrar.
var exemplosDeColar = []struct{ Rotulo, Texto string }{
	{"URL", "https://mcp.context7.com/mcp"},
	{"Processo", "npx -y @modelcontextprotocol/server-filesystem /home/eu/notas"},
	{"JSON", `{"mcpServers": {"github": {"url": "https://api.githubcopilot.com/mcp/", "headers": {"Authorization": "Bearer SEU_TOKEN"}}}}`},
	{"Claude Code", "claude mcp add --transport http linear https://mcp.linear.app/mcp"},
}

// TelaAdicionar é a página de adicionar MCP.
templ TelaAdicionar(d DadosColar) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Adicionar MCP",
		Subtitulo: "Cole o que a documentação do servidor mostra. O patchbay descobre o resto: transporte, nome e se precisa de login.",
		Secao:     webui.SecaoUpstreams,
		Usuario:   webui.UsuarioDoContexto(ctx),
	}) {
		<div class="grid gap-6 lg:grid-cols-3">
			<div class="lg:col-span-2">
				@CaixaDeColar(d)
			</div>
			<div class="flex flex-col gap-6">
				@webui.Cartao("Ou escolha na biblioteca") {
					<form method="get" action={ templ.SafeURL(webui.RotaBiblioteca) } class="flex flex-col gap-3 px-5 py-5">
						<label for="busca-biblioteca" class="text-sm text-conteudo-suave">Mais de 600 servidores conhecidos, com a configuração já pronta.</label>
						<input id="busca-biblioteca" name="q" type="search" class="pb-campo" placeholder="github, notion, postgres…"/>
						<div><button type="submit" class="pb-botao pb-botao-secundario">Buscar</button></div>
					</form>
				}
				@webui.Cartao("Prefere preencher à mão?") {
					<div class="flex flex-col gap-2 px-5 py-5 text-sm">
						<a class="pb-link" href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoHTTP) }>Servidor remoto (URL)</a>
						<a class="pb-link" href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoSTDIO) }>Processo local (comando)</a>
						<a class="pb-link" href={ templ.SafeURL(webui.RotaUpstreams + "/novo?tipo=" + TipoSSE) }>Servidor SSE antigo</a>
					</div>
				}
			</div>
		</div>
	}
}

// CaixaDeColar é o cartão de colar.
templ CaixaDeColar(d DadosColar) {
	<section id="colar" class="scroll-mt-8">
		if d.Erro != "" {
			@webui.AlertaCaixa(webui.Alerta{
				Tom:    webui.TomPerigo,
				Titulo: "Não deu para usar este texto.",
				Texto:  d.Erro,
			})
		}
		@webui.Cartao("Cole aqui") {
			<form method="post" action={ templ.SafeURL(rotaColar()) } class="flex flex-col gap-4 px-5 py-5">
				<label for="comando" class="sr-only">URL, comando ou JSON do servidor</label>
				<textarea
					id="comando"
					name="comando"
					rows="6"
					autofocus
					class="pb-campo min-h-40 resize-y font-mono text-[0.8125rem]"
					placeholder="https://mcp.exemplo.com/mcp"
					aria-describedby="comando-ajuda"
				>{ d.Texto }</textarea>
				<div id="comando-ajuda" class="flex flex-col gap-2">
					<p class="text-sm text-conteudo-suave">Serve qualquer um destes formatos:</p>
					<ul class="flex flex-col gap-1.5">
						for _, e := range exemplosDeColar {
							<li class="flex items-baseline gap-2 text-xs">
								<span class="w-24 shrink-0 font-medium text-conteudo-suave">{ e.Rotulo }</span>
								<code class="truncate rounded bg-superficie-alta px-1.5 py-0.5 font-mono text-conteudo-suave">{ e.Texto }</code>
							</li>
						}
					</ul>
				</div>
				<details class="text-sm text-conteudo-suave">
					<summary class="cursor-pointer select-none font-medium text-conteudo">Antes de colar</summary>
					<ul class="mt-2 flex list-disc flex-col gap-1.5 pl-5">
						<li>Token e senha vão cifrados para o banco e não voltam para a tela. Troque o exemplo da documentação (<code class="font-mono">SEU_TOKEN</code>) pelo valor real antes.</li>
						<li><strong>Comando de processo é executado neste servidor</strong> (npx, uvx, docker…), com o usuário do patchbay. Leia a linha antes de colar.</li>
						<li>Login por OAuth não precisa de nada aqui: se o servidor pedir, aparece o botão <strong>Conectar conta</strong> logo depois.</li>
					</ul>
				</details>
				<div>
					<button type="submit" class="pb-botao pb-botao-primario">Adicionar</button>
				</div>
			</form>
		}
	</section>
}
