package endpoint

import (
	"strconv"

	"github.com/vitoramaral10/patchbay/internal/catalogo"
	"github.com/vitoramaral10/patchbay/internal/platform/webui"
)

func rotaDo(id int64) string { return webui.RotaEndpoints + "/" + strconv.FormatInt(id, 10) }

func tomDoEstado(estado string, habilitado bool) webui.Tom {
	if !habilitado {
		return webui.TomNeutro
	}
	switch estado {
	case "pronto":
		return webui.TomSucesso
	case "degradado":
		return webui.TomPerigo
	case "conectando", "novo":
		return webui.TomAlerta
	default:
		return webui.TomNeutro
	}
}

func rotuloDoEstado(estado string, habilitado bool) string {
	if !habilitado {
		return "desabilitado"
	}
	if estado == "" {
		return "fora da supervisão"
	}
	return estado
}

// rotuloDoAviso traduz o valor interno do aviso para o texto do selo na tela.
func rotuloDoAviso(a catalogo.Aviso) string {
	switch a {
	case catalogo.AvisoRenomeada:
		return "renomeada"
	case catalogo.AvisoColisaoDeNome:
		return "colisão de nome"
	case catalogo.AvisoNomeSaneado:
		return "nome saneado"
	case catalogo.AvisoSchemaDegradado:
		return "schema degradado"
	case catalogo.AvisoOutputDescartado:
		return "output descartado"
	case catalogo.AvisoAnotacaoRemovida:
		return "anotação removida"
	default:
		return string(a)
	}
}

// tomDoAviso destaca colisão de nome e nome saneado: os dois mudam o nome
// exposto sem o admin ter escrito uma regra para isso, o caso em que a UI
// menos pode deixar a mudança passar em silêncio.
func tomDoAviso(a catalogo.Aviso) webui.Tom {
	switch a {
	case catalogo.AvisoColisaoDeNome, catalogo.AvisoNomeSaneado:
		return webui.TomAlerta
	default:
		return webui.TomInfo
	}
}

// TelaLista é a lista de endpoints.
templ TelaLista(linhas []Linha, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    "Endpoints",
		Subtitulo: "Cada endpoint é uma URL MCP que o cliente registra: ela agrega os MCPs escolhidos e é uma fronteira de autorização própria.",
		Secao:     webui.SecaoEndpoints,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      botaoNovo(),
		Alerta:    alerta,
	}) {
		if len(linhas) == 0 {
			@webui.Vazio("Nenhum endpoint ainda.",
				"Um endpoint é o que o cliente de IA registra. Crie o primeiro, escolha quais MCPs entram nele e emita uma chave de API.") {
				@botaoNovo()
			}
		} else {
			@webui.Cartao("") {
				@webui.Tabela("Endpoints publicados, com os MCPs que cada um compõe") {
					<thead class="border-b border-borda bg-superficie-alta text-xs uppercase tracking-wide text-conteudo-suave">
						<tr>
							<th scope="col" class="px-4 py-2.5 font-semibold">Endpoint</th>
							<th scope="col" class="px-4 py-2.5 font-semibold">URL</th>
							<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>MCPs</th>
							<th scope="col" class="px-4 py-2.5 font-semibold" data-numero>Ferramentas</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-borda">
						for _, l := range linhas {
							<tr class="transition-colors duration-150 ease-out hover:bg-superficie-alta">
								<td class="px-4 py-3">
									<a href={ templ.SafeURL(rotaDo(l.ID)) } class="pb-link font-medium">{ l.Titulo() }</a>
									<p class="text-xs text-conteudo-tenue">{ l.Slug }</p>
								</td>
								<td class="px-4 py-3">
									<code class="font-mono text-xs text-conteudo-suave">{ l.URL }</code>
								</td>
								<td class="px-4 py-3" data-numero>{ strconv.Itoa(l.Upstreams) }</td>
								<td class="px-4 py-3" data-numero>
									@contagemDeFerramentas(l.Ferramentas)
									if l.Lapides > 0 {
										<p class="text-xs text-conteudo-tenue">+{ strconv.Itoa(l.Lapides) } lápide(s)</p>
									}
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

// contagemDeFerramentas destaca o endpoint que passou do custo de contexto que
// um cliente aguenta bem. Quarenta é o número que a seção 11 cita.
templ contagemDeFerramentas(n int) {
	if n == 0 {
		<span class="text-conteudo-tenue">sem ferramentas</span>
	} else if n > 40 {
		<span class="font-medium text-alerta" title="Acima de 40 ferramentas o custo de contexto degrada todos os clientes deste endpoint.">
			{ strconv.Itoa(n) }
		</span>
	} else {
		{ strconv.Itoa(n) }
	}
}

templ botaoNovo() {
	<a href={ templ.SafeURL(webui.RotaEndpoints + "/novo") } class="pb-botao pb-botao-primario">Novo endpoint</a>
}

// TelaDetalhe mostra a URL, a composição e as ferramentas resultantes.
templ TelaDetalhe(d Detalhe, alerta *webui.Alerta) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    d.Titulo(),
		Subtitulo: d.Descricao,
		Secao:     webui.SecaoEndpoints,
		Usuario:   webui.UsuarioDoContexto(ctx),
		Acao:      acoesDoDetalhe(d),
		Alerta:    alerta,
	}) {
		<div class="flex flex-col gap-6">
			@cartaoConectar(d)
			@webui.Cartao("MCPs neste endpoint") {
				if len(d.Composicao) == 0 {
					<p class="px-4 py-6 text-conteudo-suave">
						Nenhum MCP ainda. Os que você adicionar entram aqui sozinhos; para escolher à mão, clique em Editar.
					</p>
				} else {
					<ul class="divide-y divide-borda">
						for _, u := range d.Composicao {
							<li class="flex flex-col gap-2 px-4 py-3">
								<div class="flex flex-wrap items-center justify-between gap-3">
									<span class="font-medium">{ u.Nome }</span>
									<span class="flex items-center gap-3">
										<span class="text-sm text-conteudo-suave" data-numero title="Ferramentas deste MCP que sobrevivem à composição deste endpoint, sobre as que ele expõe.">
											{ strconv.Itoa(u.NoEndpoint) } de { strconv.Itoa(u.Ferramentas) } ferramentas
										</span>
										@webui.Selo(tomDoEstado(u.Estado, u.Habilitado), rotuloDoEstado(u.Estado, u.Habilitado))
									</span>
								</div>
							</li>
						}
					</ul>
				}
			}
			@webui.Cartao("Ferramentas resultantes") {
				if len(d.Ferramentas) == 0 {
					<p class="px-4 py-6 text-conteudo-suave">
						Nenhuma ferramenta no ar. Lista vazia é resposta legítima: o cliente recebe
						<code class="font-mono">tools/list</code> sem itens em vez de erro, e volta a ver as
						ferramentas quando algum MCP ficar pronto.
					</p>
				} else {
					<ul class="divide-y divide-borda">
						for _, f := range d.Ferramentas {
							@itemFerramentaExposta(f)
						}
					</ul>
				}
			}
			@webui.Cartao("Instruções enviadas ao cliente") {
				if d.Instrucoes == "" {
					<p class="px-4 py-6 text-conteudo-suave">Nenhuma instrução configurada.</p>
				} else {
					<p class="max-w-[65ch] whitespace-pre-wrap px-4 py-4 text-conteudo-suave">{ d.Instrucoes }</p>
				}
			}
		</div>
	}
}

// cartaoConectar diz, por cliente, o que copiar para onde. Os clientes que
// fazem login OAuth só precisam da URL; os outros levam uma chave, gerada aqui.
templ cartaoConectar(d Detalhe) {
	@webui.Cartao("Conectar um cliente") {
		<div class="flex flex-col gap-4 px-5 py-5">
			<div class="flex flex-col gap-1.5">
				<span class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">URL deste endpoint</span>
				<code class="select-all break-all rounded-md bg-acento-fraco px-3 py-2 font-mono text-sm text-acento">{ d.URL }</code>
				<span class="text-xs text-conteudo-tenue">{ strconv.Itoa(len(d.Ferramentas)) } ferramentas de { strconv.Itoa(len(d.Composicao)) } MCPs</span>
			</div>
			<div class="flex flex-col divide-y divide-borda rounded-lg border border-borda">
				@passoCliente("claude.ai, Claude Desktop ou ChatGPT", true) {
					<ol class="flex list-decimal flex-col gap-1.5 pl-5">
						<li>Abra <strong>Configurações → Conectores → Adicionar conector personalizado</strong>.</li>
						<li>Cole a URL acima e salve.</li>
						<li>Na tela que abrir, entre com o usuário do patchbay e clique em <strong>Permitir</strong>.</li>
					</ol>
				}
				@passoCliente("Claude Code", false) {
					<p>Rode no terminal e depois use <code class="font-mono">/mcp</code> para entrar:</p>
					<pre class="select-all overflow-x-auto rounded-md bg-superficie-alta px-3 py-2 font-mono text-xs">claude mcp add --transport http { d.Slug } { d.URL }</pre>
				}
				@passoCliente("Cursor, VS Code e outros", false) {
					<p>Cole no arquivo de MCPs do cliente. Se ele não abrir a tela de login, gere uma chave abaixo.</p>
					<pre class="select-all overflow-x-auto rounded-md bg-superficie-alta px-3 py-2 font-mono text-xs">{ jsonDoCliente(d.Slug, d.URL) }</pre>
				}
				@passoCliente("Cliente sem login (chave de API)", false) {
					<p>A chave vale só para este endpoint e aparece uma vez, já com o comando pronto.</p>
					<form method="post" action={ templ.SafeURL(webui.RotaChaves) } class="flex flex-wrap items-end gap-2">
						<input type="hidden" name="endpoint" value={ strconv.FormatInt(d.ID, 10) }/>
						<div class="flex flex-col gap-1">
							<label for="nome-chave" class="text-xs font-medium text-conteudo">Para quem é</label>
							<input id="nome-chave" name="nome" required class="pb-campo w-56" placeholder="codex no notebook"/>
						</div>
						<button type="submit" class="pb-botao pb-botao-primario">Gerar chave</button>
					</form>
				}
			</div>
		</div>
	}
}

templ passoCliente(titulo string, aberto bool) {
	<details class="group px-4 py-3" open?={ aberto }>
		<summary class="cursor-pointer select-none font-medium text-conteudo group-open:text-acento">{ titulo }</summary>
		<div class="mt-3 flex flex-col gap-2 text-sm text-conteudo-suave">
			{ children... }
		</div>
	</details>
}

func jsonDoCliente(slug, url string) string {
	return "{\n  \"mcpServers\": {\n    \"" + slug + "\": { \"url\": \"" + url + "\" }\n  }\n}"
}

templ acoesDoDetalhe(d Detalhe) {
	<div class="flex items-center gap-2">
		<form
			method="post"
			action={ templ.SafeURL(rotaDo(d.ID) + "/remover") }
			hx-post={ rotaDo(d.ID) + "/remover" }
			hx-confirm={ "Remover o endpoint " + d.Slug + "? As chaves de API que só tinham escopo nele param de funcionar, e as sessões abertas são encerradas." }
			hx-disabled-elt="find button"
		>
			@webui.BotaoAcao("pb-botao-perigo", "Remover", "Removendo…")
		</form>
		<a href={ templ.SafeURL(rotaDo(d.ID) + "/editar") } class="pb-botao pb-botao-primario">Editar</a>
	</div>
}

// itemFerramentaExposta é uma ferramenta na tela de detalhe: nome exposto,
// de onde veio, e os avisos que a composição produziu para chegar nesse nome
// — sem isso, renome, colisão de nome e saneamento silenciosos seriam
// indistinguíveis de bug (regra.go:23-26).
templ itemFerramentaExposta(f FerramentaExposta) {
	<li class="flex flex-wrap items-center gap-2 px-4 py-2 text-xs">
		<span class="rounded-md bg-superficie-alta px-2 py-1 font-mono text-conteudo-suave">{ f.Nome }</span>
		if f.NomeOriginal != "" && f.NomeOriginal != f.Nome {
			<span class="text-conteudo-tenue">
				de <code class="font-mono">{ f.NomeOriginal }</code> em { f.Upstream }
			</span>
		} else if f.Upstream != "" {
			<span class="text-conteudo-tenue">{ f.Upstream }</span>
		}
		for _, a := range f.Avisos {
			@webui.Selo(tomDoAviso(a), rotuloDoAviso(a))
		}
	</li>
}

templ dado(rotulo string) {
	<div>
		<dt class="text-xs font-semibold uppercase tracking-wide text-conteudo-suave">{ rotulo }</dt>
		<dd class="mt-1 text-conteudo">
			{ children... }
		</dd>
	</div>
}

// TelaForm serve a criação e a edição.
templ TelaForm(f Form, opcoes []UpstreamOpcao) {
	@webui.Pagina(webui.DadosPagina{
		Titulo:    tituloDoForm(f),
		Subtitulo: subtituloDoForm(f),
		Secao:     webui.SecaoEndpoints,
		Usuario:   webui.UsuarioDoContexto(ctx),
	}) {
		<form method="post" action={ templ.SafeURL(acaoDoForm(f)) } class="flex max-w-3xl flex-col gap-8">
			@webui.Cartao("Identificação") {
				<div class="flex flex-col gap-6 px-4 py-5">
					if f.SlugFixo {
						<div class="flex flex-col gap-1.5">
							<span class="text-sm font-medium text-conteudo">Slug</span>
							<code class="font-mono text-conteudo">{ f.Slug }</code>
							<p class="text-sm text-conteudo-tenue">
								Não muda: ele está na URL e no público-alvo de toda credencial deste endpoint.
								Para trocar o slug, crie outro endpoint e emita chaves novas.
							</p>
						</div>
						@webui.Campo(webui.DadosCampo{
							Nome:        "nome",
							Rotulo:      "Nome",
							Valor:       f.Nome,
							Erro:        f.Erros["nome"],
							Obrigatorio: true,
						})
					} else {
						@webui.Campo(webui.DadosCampo{
							Nome:        "nome",
							Rotulo:      "Nome",
							Valor:       f.Nome,
							Ajuda:       "Por exemplo Trabalho ou Pessoal. Cada endpoint é uma URL com o seu conjunto de MCPs.",
							Erro:        f.Erros["nome"],
							Obrigatorio: true,
						})
						@webui.Campo(webui.DadosCampo{
							Nome:         "slug",
							Rotulo:       "Endereço (opcional)",
							Valor:        f.Slug,
							Ajuda:        "Vai na URL: /mcp/<endereço>. Em branco, sai do nome. Não muda depois de criado.",
							Erro:         f.Erros["slug"],
							Monoespacado: true,
							Placeholder:  "trabalho",
						})
					}
					<details open?={ f.Descricao != "" || f.Instrucoes != "" }>
						<summary class="cursor-pointer select-none text-sm font-medium text-conteudo-suave">Texto para o cliente de IA (opcional)</summary>
						<div class="mt-4 flex flex-col gap-6">
					@webui.CampoTexto(webui.DadosCampo{
						Nome:   "descricao",
						Rotulo: "Descrição",
						Valor:  f.Descricao,
						Ajuda:  "Título que o cliente MCP vê no initialize.",
					})
					@webui.CampoTexto(webui.DadosCampo{
						Nome:   "instrucoes",
						Rotulo: "Instruções para o cliente",
						Valor:  f.Instrucoes,
						Ajuda:  "Texto enviado no initialize. Alterar nome, descrição ou instruções recria o servidor MCP e encerra as sessões abertas deste endpoint; mudar só a composição não encerra nada.",
					})
						</div>
					</details>
				</div>
			}
			@webui.Cartao("MCPs e ferramentas") {
				if len(opcoes) == 0 {
					<p class="px-4 py-6 text-conteudo-suave">
						Nenhum MCP cadastrado. Crie um MCP primeiro — um endpoint sem MCP
						responde <code class="font-mono">tools/list</code> vazio.
					</p>
				} else {
					<fieldset class="flex flex-col gap-2 px-4 py-4">
						<legend class="sr-only">MCPs deste endpoint</legend>
						<p class="text-sm text-conteudo-tenue">
							Marque os MCPs que este endpoint entrega. O que você escolher aqui vale só para ele.
						</p>
						<ul class="flex flex-col gap-1">
							for _, o := range opcoes {
								@itemDaComposicao(o)
							}
						</ul>
					</fieldset>
				}
			}
			<div class="flex items-center gap-3">
				<button type="submit" class="pb-botao pb-botao-primario">
					if f.SlugFixo {
						Salvar
					} else {
						Criar endpoint
					}
				</button>
				<a href={ templ.SafeURL(webui.RotaEndpoints) } class="pb-botao pb-botao-secundario">Cancelar</a>
			</div>
		</form>
	}
}

// itemDaComposicao é um MCP no formulário: entra ou não, e quais ferramentas
// dele o cliente vê, com que nome. Prefixo e regras com glob ficam em
// "Ajustes finos", fechado.
templ itemDaComposicao(o UpstreamOpcao) {
	<li class="rounded-lg border border-borda">
		<label class="flex cursor-pointer flex-wrap items-center gap-3 px-4 py-3">
			<input
				type="checkbox"
				name="upstream"
				value={ strconv.FormatInt(o.ID, 10) }
				class="h-5 w-5 accent-[var(--pb-acento)]"
				checked?={ o.Escolhido }
			/>
			<span class="flex-1 font-semibold text-conteudo">{ o.Nome }</span>
			@webui.Selo(tomDoEstado(o.Estado, o.Habilitado), rotuloDoEstado(o.Estado, o.Habilitado))
		</label>
		<div class="flex flex-col gap-4 border-t border-borda px-4 py-4 pl-12">
			if len(o.Itens) == 0 {
				<p class="text-sm text-conteudo-tenue">As ferramentas aparecem aqui quando o MCP conectar.</p>
			} else {
				<details open?={ o.Escolhido && o.Ligadas() < len(o.Itens) }>
					<summary class="cursor-pointer select-none text-sm font-medium text-conteudo">
						Ferramentas: { strconv.Itoa(o.Ligadas()) } de { strconv.Itoa(len(o.Itens)) } ligadas
					</summary>
					<p class="mt-2 text-xs text-conteudo-tenue">Desmarque o que o cliente não deve ver. O campo ao lado troca o nome que ele vê.</p>
					<ul class="mt-3 grid gap-x-6 gap-y-1.5 md:grid-cols-2">
						for _, it := range o.Itens {
							<li class="flex items-center gap-2">
								<input type="hidden" name={ chaveNomes(o.ID) } value={ it.Nome }/>
								<label class="flex min-w-0 flex-1 cursor-pointer items-center gap-2">
									<input type="checkbox" name={ chaveLigada(o.ID) } value={ it.Nome } checked?={ it.Ligada } class="h-4 w-4 shrink-0 accent-[var(--pb-acento)]"/>
									<span class="truncate font-mono text-xs text-conteudo" title={ it.Nome }>{ it.Nome }</span>
								</label>
								<input
									type="text"
									name={ chaveRenome(o.ID) }
									value={ it.Renome }
									placeholder="renomear…"
									aria-label={ "Novo nome para " + it.Nome }
									class="pb-campo w-32 shrink-0 px-2 py-1 font-mono text-xs"
								/>
							</li>
						}
					</ul>
				</details>
			}
			<details open?={ o.ErroPrefixo != "" || o.ErroRegras != "" || o.RegrasAvancadas != "" }>
				<summary class="cursor-pointer select-none text-sm font-medium text-conteudo-suave">Ajustes finos</summary>
				<div class="mt-3 flex flex-col gap-4">
					@webui.Campo(webui.DadosCampo{
						Nome:         ChavePrefixo(o.ID),
						Rotulo:       "Prefixo dos nomes",
						Valor:        o.Prefixo,
						Erro:         o.ErroPrefixo,
						Ajuda:        "Vai na frente do nome de cada ferramenta deste MCP. Evita que dois MCPs com uma ferramenta \"search\" se confundam.",
						Placeholder:  "github_",
						Monoespacado: true,
					})
					@webui.CampoTexto(webui.DadosCampo{
						Nome:        ChaveRegras(o.ID),
						Rotulo:      "Regras avançadas",
						Valor:       o.RegrasAvancadas,
						Erro:        o.ErroRegras,
						Ajuda:       "Para grupos de ferramentas, com * : \"excluir write_*\" desliga todas que começam com write_; \"excluir *\" no fim desliga as que o MCP ganhar no futuro. A lista acima vence estas regras.",
						Placeholder: "excluir write_*",
					})
					if o.AvisoRegras != "" {
						<p class="text-xs text-alerta">{ o.AvisoRegras }</p>
					}
				</div>
			</details>
		</div>
	</li>
}

func tituloDoForm(f Form) string {
	if f.SlugFixo {
		return "Editar endpoint"
	}
	return "Novo endpoint"
}

func subtituloDoForm(f Form) string {
	if f.SlugFixo {
		return "A mudança entra em vigor na hora, sem reiniciar o patchbay."
	}
	return "Um endpoint é uma URL com o seu conjunto de MCPs. Útil para separar trabalho e pessoal."
}

func acaoDoForm(f Form) string {
	if f.SlugFixo {
		return rotaDo(f.ID)
	}
	return webui.RotaEndpoints
}
